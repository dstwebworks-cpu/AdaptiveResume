---
import Base from '../layouts/Base.astro';
// "Rewrite my resume" landing page (drafted 09/02/2026 wave). Broad rewrite intent:
// the resume is old, thin, self-written, or aimed at a job the person no longer
// wants. NOT the burned-by-a-paid-service page — that is /fix/ (linked once below).
// Own capture form (source=rewrite-page) so the page measures itself.
// Pre-launch (default): CTAs are email capture — PUBLIC_LAUNCHED=1 flips them live,
// mirroring src/pages/index.astro.
const LAUNCHED = import.meta.env.PUBLIC_LAUNCHED === '1';
const appUrl = import.meta.env.PUBLIC_APP_URL
  ?? (import.meta.env.PROD ? 'https://app.adaptiveresume.com' : 'http://localhost:5173');
const waitlistAction = appUrl + '/waitlist'; // plain form POST — the app 303s back here
const site = Astro.site ?? new URL('https://adaptiveresume.com');
const faq = [
  { q: 'My resume is years old and I wrote it myself. Is it too thin to start from?',
    a: "No — thin is the normal starting point. Most self-written resumes list the job title and a few duties and stop there. We work backwards from what that work actually involved and show you, one at a time, the tools, standards, credentials and scope you left off. You confirm the ones that are really yours. A short resume just means we have more to find together." },
  { q: 'Will you add things I never did?',
    a: "Never. Nothing goes on the page you didn't confirm. Every finding is shown to you first; you confirm it, edit it, or skip it. If a line reads wrong, you can edit it directly or leave a note and we redo that line from your note. You approve every line before it lands." },
  { q: 'How is this different from a resume rewrite service that charges hundreds?',
    a: "Three ways. One: we start from what you actually did, not from a template. Two: you see and confirm every line, so nothing is made up, and nothing you confirmed gets cut without your say-so. Three: it's a one-time payment — $49 for the base build, $149 for a build aimed at one specific posting — with no subscription and no revision haggling." },
  { q: 'What if I want it aimed at a specific job?',
    a: "That's the $149 targeted build. Bring the posting and we translate your confirmed experience into that field's language, and add 25 interview questions relevant to that role. The full breakdown is on the pricing page." },
  { q: 'Can I buy from any state?',
    a: "Almost. Right now we can't sell resume builds to residents of New Jersey or Illinois. Those two states have laws written for job-placement agencies that can also reach paid resume help, and we're staying on the safe side until that's settled. The free scan and the demo work everywhere in the United States, and if you're in one of those states we'll tell you the day this changes." },
];
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
    { '@type': 'ListItem', position: 2, name: 'Rewrite my resume' },
  ],
};
---
<Base
  title="Rewrite My Resume — Honest Resume Rewrite Service, $49"
  description="Rewrite your resume without losing what's true. We work backwards through your real experience, show what you left off, and you confirm every line. $49, once."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container narrow-hero">
      <p class="eyebrow">A resume rewrite service that starts from what you actually did</p>
      <h1>Rewrite my resume — without losing what was <span class="hl">true</span> in it.</h1>
      <p class="tagline">You wrote it years ago. It still says less than you've done.</p>
      <p class="lede">
        Upload the resume you have — old, short, self-written, aimed at a job you no longer want.
        It's a starting point, not a problem. We work backwards through your real experience and
        show you, one finding at a time, the tools, standards, credentials and scope you left off.
        You confirm each one, in your words. Nothing made up. One-time price.
      </p>
      <div class="cta-row">
        {LAUNCHED
          ? <a class="btn btn-amber btn-lg" href="#get-started">Upload your resume &amp; get started</a>
          : <a class="btn btn-amber btn-lg" href="#get-started">Join the list — 25% off at launch</a>}
        <a class="btn btn-ghost btn-lg" href="/demo/">Try the demo first</a>
      </div>
      <ul class="pills">
        <li class="pill">Nothing made up</li>
        <li class="pill">You approve every line</li>
        <li class="pill">One-time payment — no subscription</li>
      </ul>
    </div>
  </section>

  <!-- ===== WHAT A REWRITE SHOULD CHANGE ===== -->
  <section class="section alt">
    <div class="container">
      <p class="eyebrow">What a rewrite should change — and what it must not</p>
      <h2>A rewrite is not a new font. It's four specific jobs.</h2>
      <div class="grid cols-2">
        <div class="card">
          <h3>Add what's missing</h3>
          <p>Most self-written resumes list the job title and a few duties. The tools you used, the
          standards you worked to, the training you finished, the size of what you ran — usually
          none of it is on the page. We find those together and show you each one. You say
          which are really yours.</p>
        </div>
        <div class="card">
          <h3>Keep what's true</h3>
          <p>A rewrite that drops real experience to fit a template has made your resume smaller,
          not better. Nothing you confirmed gets cut without your say-so. If a rewritten line
          reads wrong, edit it directly, or leave a note and we redo that line from your note.</p>
        </div>
        <div class="card">
          <h3>Cut the filler</h3>
          <p>"Responsible for." "Hard-working team player." "Duties included." These take up
          space and tell a reader nothing. Each one gets replaced with what you actually did —
          the real task, the real scope, the real result where you have one.</p>
        </div>
        <div class="card">
          <h3>Make it readable to screening software</h3>
          <p>Before you're done, you see what hiring software actually extracts from the finished
          file. Tables, columns, images and hidden text that trip it up are gone. The finished
          resume reads cleanly to the systems that screen it, and to the people after them.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BEFORE -> AFTER ===== -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">What the rewrite looks like</p>
      <h2>Same job, same person — finally on paper</h2>
      <div class="grid cols-2">
        <div class="card">
          <h3>Before — written by the person, years ago</h3>
          <p class="muted">"Responsible for daily operations and helping customers. Worked with a
          team. Handled paperwork and reports."</p>
        </div>
        <div class="card">
          <h3>After — every line confirmed by the person</h3>
          <p>"Ran daily operations for a [N]-person team at [location] · scheduled shifts and
          covered call-outs · handled customer complaints through to resolution · kept daily
          reports current in [system] · trained [N] new hires on [procedure]."</p>
        </div>
      </div>
      <p class="muted" style="margin-top:12px">Nothing was added that wasn't already true. The team
      size, the system, the training — the person had done all of it and never written it down.
      We asked about each one; they confirmed, edited, or skipped. The brackets are where your own
      facts go. We never put in a number you didn't give us.</p>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section class="section alt" id="pricing">
    <div class="container">
      <p class="eyebrow">Pricing, stated plainly</p>
      <h2>One-time payment. No subscription. Nothing to cancel.</h2>
      <div class="grid cols-2">
        <div class="card price">
          <h3>Base build</h3>
          <p class="amount">$49<span>one-time</span></p>
          <p class="muted">Your one resume, rewritten from what you actually did — complete, honest,
          and readable to screening software.</p>
          <ul class="ticks">
            <li>Upload your resume (and your LinkedIn resume export, the PDF with your work history, if you have one) — we work backwards through all of it</li>
            <li>Every finding shown to you first; you confirm, edit, or skip each one</li>
            <li>You see what hiring software extracts from the finished file</li>
          </ul>
        </div>
        <div class="card price featured">
          <span class="tag-premium">For one specific posting</span>
          <h3>Targeted build</h3>
          <p class="amount">$149<span>one-time</span></p>
          <p class="muted">Everything in the base build, aimed at one job posting you bring us.</p>
          <ul class="ticks">
            <li>Your confirmed experience translated into that field's language</li>
            <li>25 interview questions for that role</li>
            <li>The full breakdown of the targeted build is on the <a href="/#pricing">pricing page</a></li>
          </ul>
        </div>
      </div>
      <p class="muted small">Join the list before launch and your first build is 25% off. If a
      line is wrong, we redo it from your note — one-time payment, no revision haggling.
      If you paid someone to rewrite it and it went wrong, <a href="/fix/">start here</a> instead.</p>
      <p class="muted small" style="text-align:center">If your review genuinely finds nothing for you, we'll make it right — see the <a href="/terms/">Terms</a> for the plain-language details.</p>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section">
    <div class="container narrow">
      <h2>Common questions</h2>
      {faq.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ===== GET STARTED ===== -->
  <section class="section alt" id="get-started">
    <div class="container narrow" style="text-align:center">
      {LAUNCHED
        ? <h2>Let's rewrite it — from what you actually did</h2>
        : <h2>We launch in October 2026 — be first in line</h2>}
      {LAUNCHED
        ? <p class="lede">Create your account, upload the resume you have, and we'll dig in together —
          finding real things you've earned but never wrote down. You approve every line before
          anything lands.</p>
        : <p class="lede">Join the list before launch day — that's all it takes. <b>25% off your first
          build is locked in</b>, and our Achievement Quantification Worksheet (a ready-to-use Word
          worksheet for putting real numbers to what you did) is yours the moment you join. We'll tell
          you the moment we're live. No spam.</p>}

      {LAUNCHED ? (
        <div class="cta-row" style="justify-content:center">
          <a class="btn btn-amber btn-lg" href={appUrl}>Create an account — get started today</a>
          <a class="btn btn-ghost btn-lg" href="/demo/">Try the demo first</a>
        </div>
      ) : (
        <>
          <form class="capture-form" method="post" action={waitlistAction}>
            <input type="text" name="fax_number" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
            <input type="hidden" name="source" value="rewrite-page" />
            <input type="hidden" name="redirect" value="/rewrite-my-resume/" />
            <input class="capture-email" type="email" name="email" required placeholder="you@example.com" aria-label="Your email address" />
            <button class="btn btn-amber btn-lg" type="submit">Join the list</button>
          </form>
          <p class="capture-note muted">Just your email — no account, no card. Your discount arrives with the launch email.</p>
          <p class="capture-done hide" id="captureDone">You're on the list, and your 25% is locked in. We'll tell you the moment we're live.</p>
          <a class="btn btn-premium hide" id="captureGift" href="/templates/achievement-quantification-worksheet.docx" download>Download your Achievement Quantification Worksheet</a>
          <p class="capture-err hide" id="captureErr">That email didn't look right — mind trying it again?</p>
        </>
      )}
    </div>
  </section>

  <script>
    // Returning from POST /waitlist (?joined=1|err). No-JS visitors still landed on
    // #get-started via the 303.
    const joined = new URLSearchParams(location.search).get('joined');
    if (joined) {
      const done = document.getElementById('captureDone');
      const err = document.getElementById('captureErr');
      const form = document.querySelector('.capture-form');
      if (joined === '1' && done) {
        done.classList.remove('hide');
        document.getElementById('captureGift')?.classList.remove('hide');
        if (form instanceof HTMLElement) form.style.display = 'none';
        document.querySelector('.capture-note')?.classList.add('hide');
      }
      else if (err) { err.classList.remove('hide'); }
    }
  </script>

  <style>
    .hero { padding: 58px 0 48px; background:
      radial-gradient(1100px 460px at 72% -12%, #d8e5fa, transparent 70%),
      radial-gradient(760px 380px at 4% 112%, #fdf0dc, transparent 62%),
      var(--bg); }
    .container.narrow-hero { max-width: 860px; }
    .tagline { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 700; color: var(--ink); margin: 0 0 12px; }
    .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin: 22px 0 18px; }
    .pills { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 0; }

    .container.narrow { max-width: 760px; }
    .capture-form { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
    .capture-email { flex: 1 1 240px; max-width: 360px; font-family: inherit; font-size: 1rem; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius-sm); }
    .capture-note { margin-top: 12px; font-size: .95rem; }
    .capture-done { color: var(--true); font-weight: 700; }
    .hide { display: none; }

    .price { display: flex; flex-direction: column; }
    .price.featured { border-color: #cbb4f0; box-shadow: 0 0 0 3px #ece2fb, var(--shadow-lg); position: relative; }
    .amount { font-size: 2.4rem; font-weight: 800; letter-spacing: -0.02em; margin: 6px 0 4px; }
    .amount span { font-size: .9rem; font-weight: 600; color: var(--muted); margin-left: 8px; letter-spacing: 0; }
    .ticks { list-style: none; padding: 0; margin: 14px 0 6px; }
    .ticks li { padding-left: 26px; position: relative; margin-bottom: 9px; color: var(--ink-soft); }
    .ticks li::before { content: "\2713"; position: absolute; left: 0; color: var(--true); font-weight: 800; }
    .small { font-size: .9rem; margin-top: 18px; text-align: center; }

    .faq-item { border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 12px 16px; margin: 10px 0; background: var(--card); }
    .faq-item summary { cursor: pointer; font-weight: 700; color: var(--ink); }
    .faq-item p { margin: 10px 0 2px; color: var(--ink-soft); }
  </style>
</Base>
