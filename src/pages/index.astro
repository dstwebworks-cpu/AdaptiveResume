---
import Base from '../layouts/Base.astro';
import AtsTerm from '../components/AtsTerm.astro';
// Pre-launch (default): app CTAs become email capture — set PUBLIC_LAUNCHED=1 at
// build to flip the site live. Prod builds default to the real app origin so a
// forgotten env var can never ship localhost links again (07/27 audit finding).
const LAUNCHED = import.meta.env.PUBLIC_LAUNCHED === '1';
const appUrl = import.meta.env.PUBLIC_APP_URL
  ?? (import.meta.env.PROD ? 'https://app.adaptiveresume.com' : 'http://localhost:5173');
const waitlistAction = appUrl + '/waitlist'; // plain form POST — the app 303s back here
---
<Base
  title="AdaptiveResume — you've earned more than your resume shows"
  description="Upload your resume and we'll find the skills and credentials your work involved that you left off — you confirm every line. Nothing made up. From $49, one-time."
>
  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">You're not in this alone</p>
        <h1>You've earned <span class="hl">more</span> than your resume shows.</h1>
        <p class="tagline">You did the work. Now let's get it on paper — together. You approve every line, and we don't make anything up.</p>
        <p class="lede">
          Upload your resume and we'll dig in with you — finding the standards, tools, and training
          your work involved but you never thought to list. You confirm each one, in your words.
          Built to read cleanly for the screening bots <em>and</em> the humans.
        </p>
        <div class="cta-row">
          {LAUNCHED
            ? <>
                <a class="btn btn-amber btn-lg" href="#get-started">Upload your resume &amp; get started</a>
                <a class="btn btn-ghost btn-lg" href="/demo/">See it work on a sample resume, no sign-up needed</a>
              </>
            : <>
                <a class="btn btn-amber btn-lg" href="#get-started">Join the launch list for 25% off</a>
                <a class="btn btn-ghost btn-lg" href="/demo/">See it work on a sample resume, no sign-up needed</a>
              </>}
        </div>
        <ul class="pills">
          <li class="pill">We make nothing up.</li>
          <li class="pill">Your resume reads cleanly for screening software.</li>
          <li class="pill">You approve every line.</li>
        </ul>
      </div>

      <div class="hero-visual" aria-label="Example of skills we'd find on a resume">
        <div class="demo-card">
          <div class="demo-head"><span class="dot"></span> Here's what we'd find — you tell us what's yours</div>
          <ul>
            <li>
              <span class="from"><b class="lbl">Your resume says:</b> "Showed 12 new people how we do things"</span>
              <span class="add"><b class="lbl">We'd suggest adding:</b> "Trained 12 new hires on standard work procedures" <span class="conf">you confirm</span></span>
            </li>
            <li>
              <span class="from"><b class="lbl">Your resume says:</b> "Locked out machines before repairs"</span>
              <span class="add"><b class="lbl">We'd suggest adding:</b> "OSHA lockout/tagout (LOTO) safety compliance" <span class="conf">you confirm</span></span>
            </li>
            <li>
              <span class="from"><b class="lbl">Your resume says:</b> "Counted the warehouse every month"</span>
              <span class="add"><b class="lbl">We'd suggest adding:</b> "Monthly inventory control and cycle counts" <span class="conf">you confirm</span></span>
            </li>
            <li class="ask"><span>CPR / First Aid — currently certified?</span> <span class="conf">we ask, you decide</span></li>
          </ul>
          <p class="covcap">Your facts, your numbers — put in the words employers search for. We never add a number you didn't give us.</p>
        </div>
        <p class="cap">Sample data — generic profile, no real employer shown.</p>
      </div>
    </div>
  </section>

  <!-- ===== GET STARTED (directly below the hero — the shortest path in) ===== -->
  <section id="get-started" class="section alt">
    <div class="container start">
      <p class="eyebrow">Get started</p>
      <h2>Let's see what you've been leaving off.</h2>
      {LAUNCHED
        ? <p class="lede">Create your account, upload your resume, and we'll dig in together — finding real things you've earned but never wrote down. You approve every line before anything lands.</p>
        : <p class="lede">We launch in October 2026. Join the launch list now and two things are yours: <b>25% off your first resume when we open</b>, and our ATS-Safe Resume Template (a ready-to-use Word file) the moment you join.</p>}

      {LAUNCHED ? (
        <>
          <div class="start-cta">
            <a class="btn btn-amber btn-lg" href={appUrl}>Create an account — get started today</a>
            <p class="start-alt muted">Already have an account? <a href={appUrl + '/login'}>Sign in now</a></p>
          </div>
          <p class="reoffer muted">
            Want to see it first? <a href="/demo/">See it work on a sample resume</a>, with no sign-up needed.
          </p>
        </>
      ) : (
        <div class="start-cta" id="capture">
          <form class="capture-form" method="post" action={waitlistAction}>
            <input type="text" name="fax_number" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
            <input type="hidden" name="source" value="site-hero" />
            <input class="capture-email" type="email" name="email" required placeholder="you@example.com" aria-label="Your email address" />
            <button class="btn btn-amber btn-lg" type="submit">Join the launch list</button>
          </form>
          <p class="start-alt muted">We only need your email. There is no account to create and no card to enter. We will send an occasional useful note before launch, and your discount arrives in the launch email. No spam.</p>
          <p class="capture-done hide" id="captureDone">You&#39;re on the list, and your 25% is locked in. We&#39;ll send the occasional useful note and tell you the moment we&#39;re live.</p>
          <a class="btn btn-premium hide" id="captureGift" href="/templates/resume-format-for-ats-template.docx" download>Download your ATS-Safe Resume Template</a>
          <p class="capture-err hide" id="captureErr">That email didn't look right — mind trying it again?</p>
        </div>
      )}
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section id="how-it-works" class="section alt">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2>Three steps. You stay the author the whole way.</h2>
      <div class="grid cols-3 steps">
        <div class="card">
          <span class="step-n">1</span>
          <h3>Upload</h3>
          <p>We work from up to three of your old resumes plus your LinkedIn export, and you confirm what is yours. We only ever use the files you upload.</p>
        </div>
        <div class="card">
          <span class="step-n">2</span>
          <h3>Confirm</h3>
          <p>We'll show you skills and credentials common to work like yours and ask which ones are really you. Nothing lands on your resume until you say it's yours.</p>
        </div>
        <div class="card">
          <span class="step-n">3</span>
          <h3>Download</h3>
          <p>Get a clean resume that screening software (<AtsTerm />) can read, built only from what you confirmed, and see for yourself how that software reads it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- VIDEO SECTION REMOVED 07/25/2026 (TODO A3: no placeholder until the real cut exists — a
       promise broken on-page converts worse than absence). When the founder video ships, restore a
       "See it work first" section here (id="demo", click-to-play per the LOCKED 06/17 decision —
       never autoplay, never background). The .video-ph / .play styles are retained in the <style>
       block below for that return. Also re-add the "watch the walkthrough" link in .reoffer above. -->

  <!-- ===== FOR JOB SEEKERS ===== -->
  <section id="job-seekers" class="section alt">
    <div class="container jobs-grid">
      <div>
        <p class="eyebrow">For job seekers</p>
        <h2>The resume that finally reflects the work you did.</h2>
        <p class="lede">For career changers, military and government-to-private transitions, the trades, and specialists who do far more than their resume shows.</p>
        <ul class="ticks">
          <li>We'll find the skills and credentials you left off — you confirm each one, in your words</li>
          <li>Aiming at one specific job? Our $149 Targeted resume aims your experience at it.</li>
          <li>Aiming at a new field? Our Targeted resume turns government, military, and trade terms into language the hiring side recognizes. <a href="#military">See a real translation.</a></li>
          <li>See for yourself how the screening software reads your resume</li>
          <li>Paid a resume service and got a template back? Bring the draft you paid for and we finish what it started. See <a href="/fix/">Fix a resume you paid for</a>.</li>
        </ul>
        <a class="btn btn-primary" href="#pricing">See pricing</a>
      </div>
      <img src="/img/resume-doc.svg" width="480" height="320" alt="A resume with newly found skills highlighted and a format check" loading="lazy" />
    </div>
  </section>

  <!-- ===== HOW WE DIFFER (comparison) ===== -->
  <section id="compare" class="section alt">
    <div class="container">
      <p class="eyebrow">How we differ</p>
      <h2>How AdaptiveResume compares to other resume tools.</h2>
      <p class="lede" style="max-width:62ch">Many tools either make you do all the thinking, or do too much of it — and invent things along the way. Here's the honest difference, by category.</p>
      <div class="table-wrap">
        <table class="compare">
          <thead>
            <tr>
              <th>What matters</th>
              <th class="us">AdaptiveResume</th>
              <th>Template builders</th>
              <th>AI generators</th>
              <th>Human writers</th>
            </tr>
          </thead>
          <tbody>
            <tr><th>Works from your uploaded resumes or an export from your LinkedIn profile</th><td class="us c">✓</td><td class="x">✗</td><td class="p">~</td><td class="c">✓</td></tr>
            <tr><th>Finds what you left off</th><td class="us c">✓</td><td class="x">✗</td><td class="p">~</td><td class="c">✓</td></tr>
            <tr><th>Nothing made up</th><td class="us c">✓</td><td class="c">✓</td><td class="x">✗</td><td class="c">✓</td></tr>
            <tr><th>Asks you before anything lands in your final resume</th><td class="us c">✓</td><td class="c">✓</td><td class="x">✗</td><td class="p">~</td></tr>
            <tr><th>Shows you how screening software reads your resume</th><td class="us c">✓</td><td class="x">✗</td><td class="p">~</td><td class="x">✗</td></tr>
            <tr><th>Translates across fields (military / gov / industry)</th><td class="us c">✓</td><td class="x">✗</td><td class="p">~</td><td class="c">✓</td></tr>
            <tr><th>Typical cost</th><td class="us">$49–$149<br /><span class="sub">one-time</span></td><td>$0–$40<br /><span class="sub">often subscription</span></td><td>$10–$50+<br /><span class="sub">often subscription</span></td><td>$120–$700+<br /><span class="sub">one-time</span></td></tr>
          </tbody>
        </table>
      </div>
      <p class="scroll-hint" aria-hidden="true">Slide the table to see the other tools.</p>
      <p class="muted small" style="margin-top:12px">Cost ranges are typical figures for each category, for comparison — not quotes from specific companies. "~" means it depends on the tool. We never promise an outcome.</p>
    </div>
  </section>

  <!-- ===== THE HONEST CHATBOT QUESTION ===== -->
  <section id="vs-chat" class="section">
    <div class="container" style="max-width:820px">
      <p class="eyebrow">The honest question</p>
      <h2>"Can't I just ask a chatbot to do this?"</h2>
      <p class="lede">
        You can ask — and you'll get back something that reads well. Here's the difference: we've
        spent months building a system designed so false experience, invented skills, and AI's
        made-up "facts" can't reach your resume. <b>Nothing goes on the page until you confirm
        it's true — and we work backwards from the jobs you've actually held to find what you
        never typed at all.</b>
      </p>
      <ul class="ticks">
        <li><b>A chatbot writes first and leaves you to catch what isn't true.</b> It puts plausible-sounding credentials straight into the draft, and spotting the false ones inside smooth, confident writing is genuinely hard. With AdaptiveResume, it works the other way around: every suggestion arrives as a question, and nothing goes on the page until you say yes.</li>
        <li><b>A chatbot polishes what you already wrote.</b> We dig into what work like yours really involves — the certifications, safety standards, and training that belong on your resume but weren't in your head to ask about. That's the part you can't prompt your way to.</li>
        <li><b>You finish with real files, not text in a chat window.</b> Finished Word and PDF, your original words quoted back on every finding, checked against what screening software reads — every check shown to you.</li>
      </ul>
      <p><a href="/demo/">See it work on a sample resume, no sign-up needed.</a></p>

      <!-- ===== HOW LONG IT TAKES (toggle: a resume writer / doing it yourself with a chatbot).
           Retitled and rewritten 09/19/2026 (hero-page clarity audit, founder-approved item 2). ===== -->
      <div class="timemath">
        <h3>How long it takes</h3>
        <p class="muted">You never do this alone. We go through your resume with you: no appointment to wait for, at your pace, one finding at a time.{LAUNCHED && ' You can start right now.'}</p>
        <p class="tm-lead">Compare the time it takes with:</p>
        <div class="tm-tabs">
          <button class="tm-tab active" data-tm="writer">A resume writer</button>
          <button class="tm-tab" data-tm="diy">Doing it yourself with a chatbot</button>
        </div>
        <div class="tm-panel" data-tm="writer">
          <div class="tm-col">
            <h4>A professional writing service</h4>
            <ul>
              <li>Day one: you book, pay, and fill out their questionnaire.</li>
              <li>A first draft arrives in 3 to 7 business days.</li>
              <li>Revisions add roughly another week.</li>
              <li><b>In total, you wait one to two weeks.</b></li>
            </ul>
          </div>
          <div class="tm-col us">
            <h4>AdaptiveResume</h4>
            <ul>
              <li>Upload your resume. Within seconds you see a free format check of how screening software reads it.</li>
              <li>The first suggestions appear moments after you start, and you say yes or no to each one.</li>
              <li>You go at your own pace. If you get interrupted, we save your place.</li>
              <li><b>In total, you finish today.</b> A live clock shows on screen whenever we are working, so you always know where things stand.</li>
            </ul>
          </div>
        </div>
        <div class="tm-panel hide" data-tm="diy">
          <div class="tm-col">
            <h4>Doing it yourself with a chatbot</h4>
            <ul>
              <li>You prompt and re-prompt until something is usable.</li>
              <li>Then comes the step almost nobody does: checking every line yourself, because nothing else checks it.</li>
              <li>Then you wrestle the text into a clean file that screening software can read.</li>
              <li><b>Your active work is an evening or more, and all of the checking is on you.</b></li>
            </ul>
          </div>
          <div class="tm-col us">
            <h4>AdaptiveResume</h4>
            <ul>
              <li>We do the digging, the checking, and the formatting. The checks are built in, so nothing depends on you remembering to do them.</li>
              <li>You spend your time on the one thing only you can do: confirming what is true.</li>
              <li>You finish the same sitting with checked, formatted Word and PDF files.</li>
              <li><b>Your active work is one focused session, guided the whole way.</b></li>
            </ul>
          </div>
        </div>
        <p class="muted small">Turnaround comparisons reflect typical advertised timelines of major resume-writing services (2026). We never promise a fixed duration — you'll always see a live clock while we work.</p>
      </div>
    </div>
  </section>

  <!-- ===== MILITARY / GOVERNMENT TRANSLATION PROOF ===== -->
  <section id="military" class="section alt">
    <div class="container" style="max-width:820px">
      <p class="eyebrow">Military &amp; government transitions</p>
      <h2>Your record is strong. Its language is the problem.</h2>
      <p class="lede">
        Civilian screening software has never heard of an AMAL block, an NCOER, or a property book.
        Our Targeted resume translates what you actually did into the words civilian employers search for, and you approve every line.
      </p>
      <div class="beforeafter">
        <div class="ba-row"><span class="ba-tag">Your resume says</span>
          <p>"Maintained AMAL blocks and surgical instrument sets"</p></div>
        <div class="ba-row after"><span class="ba-tag">Translated — same truth, their words</span>
          <p>"Performed sterile processing end to end — decontamination, assembly, sterilization, and quality inspection of surgical instrument sets and case carts — to hospital SPD standards."</p></div>
      </div>
      <p class="muted small">Sample translation — generic profile, no real service member shown.</p>
      <p><a href="/demo/?p=military">See it work on a military sample, no sign-up needed.</a></p>
    </div>
  </section>

  <!-- ===== PRICING (consumer only) ===== -->
  <section id="pricing" class="section">
    <div class="container">
      <p class="eyebrow">Pricing</p>
      <h2>One-time payment. No subscription. Nothing to cancel.</h2>
      <div class="grid cols-2 pricing">
        <div class="card price">
          <h3>Base resume</h3>
          <p class="amount">$49<span>one-time</span></p>
          <p class="muted">Your one resume, made complete — everything you've earned, finally on paper.</p>
          <ul class="ticks">
            <li>We work from up to three of your old resumes plus your LinkedIn export, and you confirm what is yours.</li>
            <li>We'll dig through them together and find what you left off — you confirm what's yours</li>
            <li>Reads cleanly for the screening software, and for the person after it</li>
            <li>We run the format checks screening software cares about — and show you each one</li>
          </ul>
          <a class="btn btn-primary" href="#get-started">{LAUNCHED ? 'Get started' : 'Join the launch list for 25% off'}</a>
        </div>

        <div class="card price featured">
          <span class="tag-premium">For a specific role</span>
          <h3>Targeted resume</h3>
          <p class="amount">$149<span>one-time</span></p>
          <p class="muted">Everything in the Base resume, plus we aim your resume at the one job you are going for, in the language that employer's hiring team recognizes.</p>
          <ul class="ticks">
            <li>We translate your experience into the language that job posting uses.</li>
            <li>We show you, side by side, what the posting asks for, what your resume covers, and what it does not.</li>
            <li>You get 25 interview questions for that exact role, each traced to the posting and to your own resume lines.</li>
          </ul>
          <p class="muted" style="font-size:.92em">Your finished resume is a file you keep, and you can send it to as many employers as you want.</p>
          <a class="btn btn-premium" href="#get-started">{LAUNCHED ? 'Get started' : 'Join the launch list for 25% off'}</a>
        </div>
      </div>
      <p class="muted finep">{LAUNCHED ? 'Your second resume is 25% off, and every one after that is 50% off.' : 'If you join the launch list, your first resume is 25% off. Your second resume is also 25% off, and every one after that is 50% off.'}</p>
      <p class="muted finep">If we genuinely find nothing to add to your resume, we rework it with you. The plain-language details are in our <a href="/terms/">Terms</a>.</p>
    </div>
  </section>

  <!-- ===== COMMERCIAL BANNER (links to dedicated page) ===== -->
  <section class="section tint">
    <div class="container banner">
      <img src="/img/office-desk.svg" width="480" height="320" alt="Two people talking across an office desk" loading="lazy" />
      <div>
        <p class="eyebrow">For organizations</p>
        <h2>Hiring, staffing, or placing people?</h2>
        <p class="lede">AdaptiveResume finds what every candidate's resume left off, one batch at a time, with the same promise: nothing made up. It is built for staffing agencies, outplacement firms, workforce boards, and veteran and reentry nonprofits.</p>
        <a class="btn btn-primary btn-lg" href="/business/">See plans for organizations</a>
      </div>
    </div>
  </section>

  <!-- ===== LEGAL NOTE ===== -->
  <section id="legal" class="section legal-strip">
    <div class="container legalnote">
      <p class="muted">
        <b>How AdaptiveResume works:</b> We never make anything up. Your resume reads cleanly for screening software (<AtsTerm />). We only add things you confirm are true. Any edit you make stays.
        Read the full <a href="/terms/">Terms of Service</a>, <a href="/privacy/">Privacy Policy</a>, and
        <a href="/disclaimer/">Disclaimer</a>.
      </p>
    </div>
  </section>

  <style>
    /* hero — cool glow top-right, warm glow bottom-left for depth */
    .hero { padding: 58px 0 40px; background:
      radial-gradient(1100px 460px at 72% -12%, #d8e5fa, transparent 70%),
      radial-gradient(760px 380px at 4% 112%, #fdf0dc, transparent 62%),
      var(--bg); }
    .hero-grid { display: grid; gap: 36px; align-items: center; }
    @media (min-width: 960px) { .hero-grid { grid-template-columns: 1.05fr 0.95fr; padding-top: 18px; } }
    .tagline { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 700; color: var(--ink); margin: 0 0 12px; }
    .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin: 22px 0 18px; }
    .pills { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 0; }

    .demo-card { background: linear-gradient(160deg, #16244a, #0b1226); color: #e6ecfb; border: 1px solid #2a3a6b; border-radius: var(--radius); padding: 18px 18px 14px; box-shadow: 0 18px 52px rgba(16,32,64,.28); }
    .demo-head { font-size: .82rem; letter-spacing: .04em; color: #9fb3e0; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
    .demo-head .dot { width: 9px; height: 9px; border-radius: 50%; background: #4ade80; display: inline-block; }
    .demo-card ul { list-style: none; margin: 0 0 16px; padding: 0; }
    .demo-card li { padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,.08); font-size: .92rem; }
    .demo-card li.ask { display: flex; justify-content: space-between; gap: 12px; }
    /* one text size in-card (locked rule) — hierarchy by color/weight only */
    .demo-card .from { display: block; color: #8fa3cf; }
    .demo-card .add { display: block; color: #c9f7d8; }
    .demo-card .lbl { font-weight: 700; }
    .demo-card .conf { color: #9fb3e0; font-size: .8rem; white-space: nowrap; }
    .demo-card li.ask span:first-child { color: #ffe1a8; }
    .covcap { font-size: .8rem; color: #9fb3e0; margin: 4px 0 0; }
    .cap { font-size: .78rem; color: var(--muted); margin-top: 10px; text-align: center; }

    /* steps */
    .steps .card { position: relative; padding-top: 30px; }
    .steps .card:hover { box-shadow: var(--shadow-lg); }
    .step-n { position: absolute; top: -16px; left: 22px; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 9px; background: var(--accent-strong); color: #16202b; font-weight: 800; }

    /* demo + jobs split */
    .demo-grid, .jobs-grid { display: grid; gap: 30px; align-items: center; }
    @media (min-width: 880px) { .demo-grid, .jobs-grid { grid-template-columns: 1fr 1fr; } }
    .jobs-grid img { border-radius: var(--radius); box-shadow: var(--shadow); width: 100%; height: auto; }
    .video-ph { position: relative; aspect-ratio: 16/9; border-radius: var(--radius); background: linear-gradient(135deg,#1b2740,#0f1830); color: #cdd7ef; display: grid; place-items: center; text-align: center; padding: 16px; box-shadow: var(--shadow-lg); }
    .video-ph span { font-size: .85rem; opacity: .8; position: absolute; bottom: 14px; }
    .video-ph .play { width: 64px; height: 64px; border-radius: 50%; border: none; background: linear-gradient(180deg, #fbb043, var(--accent-strong)); color: #16202b; font-size: 1.3rem; cursor: pointer; box-shadow: 0 8px 24px rgba(217,119,6,.4); transition: transform .1s; }
    .video-ph .play:hover { transform: scale(1.06); }

    .ticks { list-style: none; padding: 0; margin: 14px 0 18px; }
    .ticks li { padding-left: 26px; position: relative; margin-bottom: 9px; color: var(--ink-soft); }
    .ticks li::before { content: "✓"; position: absolute; left: 0; color: var(--true); font-weight: 800; }

    /* pricing */
    .pricing .price { display: flex; flex-direction: column; }
    .price.featured { border-color: #cbb4f0; box-shadow: 0 0 0 3px #ece2fb, var(--shadow-lg); position: relative; }
    .amount { font-size: 2.4rem; font-weight: 800; letter-spacing: -0.02em; margin: 6px 0 4px; }
    .amount span { font-size: .9rem; font-weight: 600; color: var(--muted); margin-left: 8px; letter-spacing: 0; }
    .price .btn { margin-top: auto; align-self: flex-start; }
    .finep { text-align: center; margin-top: 24px; font-size: .9rem; }

    /* comparison table (scrolls horizontally on small screens) */
    .table-wrap { overflow-x: auto; margin-top: 18px; -webkit-overflow-scrolling: touch; border-radius: var(--radius); }
    .compare { width: 100%; min-width: 720px; border-collapse: collapse; background: var(--card); }
    .compare th, .compare td { padding: 14px 16px; text-align: center; border-bottom: 1px solid var(--line); font-size: .95rem; vertical-align: middle; }
    .compare thead th { background: var(--surface); font-weight: 700; color: var(--ink); }
    .compare tbody th { text-align: left; font-weight: 600; color: var(--ink-soft); }
    .compare .us { background: var(--primary-bg); }
    .compare thead th.us { color: var(--primary); }
    .compare .c { color: var(--true); font-weight: 800; font-size: 1.05rem; }
    .compare .x { color: #b42318; font-weight: 800; font-size: 1.05rem; }
    .compare .p { color: var(--muted); font-weight: 800; }
    .compare .sub { font-size: .76rem; color: var(--muted); font-weight: 400; }
    @media (max-width: 719px) {
      .compare { min-width: 560px; }
      .compare th, .compare td { padding: 10px 10px; font-size: .88rem; }
      .compare thead th { font-size: .84rem; }
    }
    .small { font-size: .85rem; }

    /* commercial banner */
    .banner { display: grid; gap: 28px; align-items: center; }
    @media (min-width: 880px) { .banner { grid-template-columns: 0.9fr 1.1fr; } }
    .banner img { border-radius: var(--radius); box-shadow: var(--shadow); width: 100%; height: auto; }

    /* get started */
    .start-cta { margin: 20px 0 6px; }
    .start-alt { margin-top: 12px; font-size: .95rem; }
    .start-alt a { font-weight: 700; }
    /* Pre-launch capture: one row on desktop, stacks on mobile (mobile-first rule). */
    .capture-form { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
    .capture-email { flex: 1 1 260px; max-width: 380px; padding: 14px 16px; font-size: 1rem;
      border: 1px solid rgba(0,0,0,.25); border-radius: 10px; }
    .capture-done, .capture-err { margin-top: 12px; font-weight: 700; }
    .capture-done.hide, .capture-err.hide { display: none; }
    /* the gift button is a .btn (inline-flex) — the id rule outranks it, so .hide
       actually hides (the guide-gate lesson: display rules silently beat weaker hides) */
    #captureGift.hide { display: none !important; }
    #captureGift { margin-top: 10px; }
    .start { max-width: 720px; text-align: center; }
    .start .lede { margin-left: auto; margin-right: auto; max-width: 56ch; }
    .dropzone { display: block; cursor: pointer; border: 2px dashed #9fb0c4; border-radius: var(--radius); background: var(--card); padding: 34px 20px; margin: 12px 0 14px; transition: border-color .15s, background .15s, box-shadow .15s; }
    .dropzone:hover { border-color: var(--accent-strong); background: #fffdf8; box-shadow: 0 0 0 4px var(--accent-bg); }
    .dropzone input { position: absolute; width: 1px; height: 1px; opacity: 0; }
    .dz-ico { display: block; font-size: 1.8rem; color: var(--accent); }
    .dz-main { display: block; font-weight: 700; font-size: 1.1rem; margin: 6px 0 2px; }
    .dz-sub { display: block; font-size: .9rem; }
    .reoffer { font-size: .95rem; }

    /* time math */
    .timemath { margin-top: 34px; }
    .timemath h3 { font-size: 1.3rem; margin: 0 0 6px; }
    .tm-lead { margin: 14px 0 8px; font-weight: 600; }
    .tm-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; }
    .tm-tab { font: inherit; font-size: .9rem; font-weight: 700; padding: 8px 16px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--card); color: var(--ink); cursor: pointer; }
    .tm-tab.active { background: var(--primary); border-color: var(--primary); color: #fff; }
    .tm-panel { display: grid; gap: 14px; }
    @media (min-width: 760px) { .tm-panel { grid-template-columns: 1fr 1fr; } }
    .tm-panel.hide { display: none; }
    .tm-col { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; }
    .tm-col.us { border-color: #7fb08a; background: #f3faf4; }
    .tm-col h4 { margin: 0 0 8px; font-size: 1rem; }
    .tm-col ul { margin: 0; padding-left: 18px; }
    .tm-col li { margin-bottom: 8px; color: var(--ink-soft); font-size: .95rem; }

    /* military before/after */
    .beforeafter { display: grid; gap: 12px; margin: 18px 0 10px; }
    .ba-row { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 18px; }
    .ba-row.after { border-color: #7fb08a; background: #f3faf4; }
    .ba-tag { display: block; font-size: .78rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
    .ba-row.after .ba-tag { color: #2f7a45; }
    .ba-row p { margin: 0; font-size: 1rem; }

    /* founder 07/28: dead air around the strip — 50px less above, 30px less below (was 74/74) */
    .legal-strip { padding: 24px 0 44px; }
    .legalnote { text-align: center; }
    .legalnote p { max-width: 80ch; margin: 0 auto; font-size: .9rem; }
  </style>
  <script>
    // Pre-launch capture: returning from POST /waitlist with ?joined=1|err — show
    // the outcome in place of / under the form. No-JS visitors still landed on
    // #get-started via the 303, so nothing depends on this running.
    const joined = new URLSearchParams(location.search).get('joined');
    if (joined) {
      const done = document.getElementById('captureDone');
      const err = document.getElementById('captureErr');
      const form = document.querySelector('.capture-form');
      if (joined === '1' && done) {
        done.classList.remove('hide');
        document.getElementById('captureGift')?.classList.remove('hide');
        if (form instanceof HTMLElement) form.style.display = 'none';
      }
      else if (err) { err.classList.remove('hide'); }
    }

    // Time-math toggle (vs writer / vs DIY chat)
    document.querySelectorAll('.tm-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        const key = tab.getAttribute('data-tm');
        document.querySelectorAll('.tm-tab').forEach((t) => t.classList.toggle('active', t === tab));
        document.querySelectorAll('.tm-panel').forEach((p) => p.classList.toggle('hide', p.getAttribute('data-tm') !== key));
      });
    });
  </script>
</Base>
