---
import Base from '../layouts/Base.astro';
// Homepage, option C (founder 11/20/2026: "I really like the blue intro option C"; "I like it as is, let's go").
// One system on this page: the body, section and page title sizes only; weights 400 and 700; ink and one gray for text;
// navy for the brand; amber only on the Buy now button and the AR Pass highlight. Sections have 28 to 40 px above and below.
// Pre-launch (default): app CTAs become email capture; set PUBLIC_LAUNCHED=1 at build to flip the site live. Prod builds
// default to the real app origin so a forgotten env var can never ship localhost links again (07/27 audit finding).
const LAUNCHED = import.meta.env.PUBLIC_LAUNCHED === '1';
const appUrl = import.meta.env.PUBLIC_APP_URL
  ?? (import.meta.env.PROD ? 'https://app.adaptiveresume.com' : 'http://localhost:5173');
const waitlistAction = appUrl + '/waitlist'; // plain form POST; the app 303s back here
const examples = [
  { says: 'Showed 12 new people how we do things.', add: 'Trained 12 new hires on standard work procedures.' },
  { says: 'Locked out machines before repairs.', add: 'OSHA lockout/tagout (LOTO) safety compliance.' },
  { says: 'Counted the warehouse every month.', add: 'Monthly inventory control and cycle counts.' },
];
---
<Base
  title="You've earned more than your resume shows | AdaptiveResume"
  description="Upload your resume, and we'll find the skills and credentials your work earned but your resume left off. Nothing goes on it unless you confirm it."
>
  <!-- ===== HERO ===== -->
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>You've earned more than your resume shows.</h1>
        <p class="sub">Upload your resume and we'll find the skills, tools and training your work involved but your resume leaves out. Nothing goes on your resume until you tell us it's right.</p>
        <div class="cta">
          {LAUNCHED
            ? <a class="btn btn-amber btn-lg buy-now" data-hero-buy href={`${appUrl}/buy`}>Buy now</a>
            : <a class="btn btn-amber btn-lg" href="#get-started">Join the launch list for 25% off</a>}
          {LAUNCHED && <p class="step-line">The Single Resume Build is $29. The AR Pass is $99 for up to 10 targeted builds in 90 days. There's no subscription and no&nbsp;auto-renewal.</p>}
          {LAUNCHED && <p class="free-link">Not ready to buy? <a href={`${appUrl}/?start=check`}>Check your resume free</a>.</p>}
        </div>
      </div>
      <div class="hero-visual">
        <div class="proof" aria-label="A sample of what we'd ask you about">
          <p class="bar"><span class="dot" aria-hidden="true"></span>Here's what we'd ask you about.</p>
          <ul>
            {examples.map((e) => (
              <li>
                <p class="says">Your resume says "{e.says}"</p>
                <p class="add"><b>We'd ask about adding</b> "{e.add}"</p>
                <p class="choice" aria-hidden="true"><span class="yes">Add this</span><span class="no">Skip</span></p>
              </li>
            ))}
          </ul>
        </div>
        <p class="cap">This is a sample with a made-up profile. You choose "Add this" or "Skip" for every one.</p>
      </div>
    </div>
  </section>

  {!LAUNCHED && (
    <section id="get-started" class="home-sec">
      <div class="container start">
        <h2>Let's see what you've been leaving off.</h2>
        <p class="gray">We launch in October 2026. Join the launch list now and two things are yours: <b>25% off your first resume when we open</b>, and our ATS-Safe Resume Template (a ready-to-use Word file) the moment you join.</p>
        <div class="start-cta" id="capture">
          <form class="capture-form" method="post" action={waitlistAction}>
            <input type="text" name="fax_number" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
            <input type="hidden" name="source" value="site-hero" />
            <input class="capture-email" type="email" name="email" required placeholder="you@example.com" aria-label="Your email address" />
            <button class="btn btn-amber btn-lg" type="submit">Join the launch list</button>
          </form>
          <p class="start-alt gray">We only need your email. There is no account to create and no card to enter. We will send an occasional useful note before launch, and your discount arrives in the launch email. No spam.</p>
          <p class="capture-done hide" id="captureDone">You&#39;re on the list, and your 25% is locked in. We&#39;ll send the occasional useful note and tell you the moment we&#39;re live.</p>
          <a class="btn btn-premium hide" id="captureGift" href="/templates/resume-format-for-ats-template.docx" download>Download your ATS-Safe Resume Template</a>
          <p class="capture-err hide" id="captureErr">That email didn't look right. Mind trying it again?</p>
        </div>
      </div>
    </section>
  )}

  <!-- ===== HOW IT WORKS ===== -->
  <section id="how-it-works" class="home-sec white">
    <div class="container">
      <h2>Three steps, and you stay the author.</h2>
      <ol class="steps">
        <li><h3>Upload your resume.</h3><p>Add up to three old resumes and your LinkedIn export, and we work only from what you give us.</p></li>
        <li><h3>Answer our questions.</h3><p>We ask about skills and credentials common to work like yours, and you say yes or no to each one.</p></li>
        <li><h3>Download your resume.</h3><p>You get clean Word and PDF files that screening software reads, built only from what you confirmed.</p></li>
      </ol>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section id="pricing" class="home-sec soft">
    <div class="container">
      <h2>Pick your build.</h2>
      <div class="prices">
        <div class="price">
          <div class="top"><h3>Single Resume Build</h3></div>
          <p class="amt">$29</p>
          <p class="gray">You get one complete resume, built with you. Use it any time within 90 days.</p>
          <ul>
            <li>We go through up to three old resumes and your LinkedIn export with you.</li>
            <li>We find the skills and credentials your work earned but your resume left off.</li>
            <li>We run the format checks screening software cares about and show you each one.</li>
          </ul>
          <a class="btn btn-primary" data-hide-header-buy href={LAUNCHED ? appUrl + '/buy?pick=base' : '#get-started'}>{LAUNCHED ? 'Get your resume build' : 'Join the launch list for 25% off'}</a>
        </div>
        <div class="price best">
          <div class="top"><h3>AR Pass</h3><span class="tag">Best value</span></div>
          <p class="amt">$99</p>
          <p class="gray">You get up to 10 resumes within 90 days, each aimed at a job you want.</p>
          <ul>
            <li>It includes everything the single build does.</li>
            <li>We put each resume in the language that job posting uses.</li>
            <li>We put together 25 practice interview questions for each role.</li>
          </ul>
          <a class="btn btn-primary" data-hide-header-buy href={LAUNCHED ? appUrl + '/buy?pick=targeted' : '#get-started'}>{LAUNCHED ? 'Get the AR Pass' : 'Join the launch list for 25% off'}</a>
        </div>
      </div>
      <p class="gray note">Each purchase is one payment, and nothing renews, so there is nothing to cancel. The details are in our <a href="/terms/">Terms</a>.</p>
    </div>
  </section>

  <!-- ===== WHY NOT A CHATBOT ===== -->
  <section id="vs-chat" class="home-sec navy">
    <div class="container narrow">
      <h2>Why not just ask a chatbot?</h2>
      <p>A chatbot writes first and leaves you to catch what isn't true. We ask first, and nothing goes on your resume until you tell us it's right. You finish with real files, and we show you how screening software reads them.</p>
    </div>
  </section>

  <!-- ===== FIND YOUR PAGE ===== -->
  <section id="job-seekers" class="home-sec white">
    <div class="container">
      <h2>Find the page made for you.</h2>
      <div class="who">
        <a href="/career-change/"><span>I'm changing careers</span></a>
        <a href="/veterans/"><span>I'm leaving the military</span></a>
        <a href="/nurses/"><span>I'm a nurse</span></a>
        <a href="/fix/"><span>I paid for a resume that fell short</span></a>
      </div>
      <p class="gray org">Hiring, staffing or placing people? <a href="/business/">See our plans for organizations</a>.</p>
    </div>
  </section>

  <style>
    /* One rhythm for every section (founder 11/20/2026: the old gaps took about a third of a phone screen). */
    section { padding: clamp(28px, 3vw, 40px) 0; }
    h1, h2 { font-weight: 700; }
    h1 { margin: 0; }
    h2 { margin: 0 0 20px; }
    h3 { font-size: var(--fs-body); font-weight: 700; margin: 0; letter-spacing: 0; }
    p { margin: 0; }
    .gray { color: var(--muted); }
    .white { background: #fff; }
    .soft { background: var(--surface); }
    .navy { background: var(--primary); color: #fff; }
    .navy h2 { color: #fff; }
    .narrow { max-width: 820px; }

    /* hero: a navy band with white type, the sample card beside it on wide screens */
    .home-hero { background: var(--primary); color: #fff; padding-top: 32px; }
    .home-hero h1 { color: #fff; }
    .hero-grid { display: grid; gap: 28px; align-items: center; }
    @container (min-width: 54rem) { .hero-grid { grid-template-columns: 1.05fr 1fr; gap: 56px; } }
    .sub { margin-top: 16px; color: #d5deea; max-width: 36em; }
    .cta { margin-top: 24px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
    .home-hero .step-line { margin: 0; color: #d5deea; }
    .home-hero .free-link { margin: 0; color: #d5deea; }
    .home-hero .free-link a { color: #fff; }
    .home-hero .btn-amber { box-shadow: none; }

    /* the sample card, drawn like the app */
    .proof { background: #fff; color: var(--ink); border-radius: var(--radius); overflow: hidden; }
    .proof .bar { display: flex; align-items: flex-start; gap: 8px; padding: 14px 20px; border-bottom: 1px solid var(--line); background: var(--surface); font-weight: 700; }
    .proof .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--true); flex: none; margin-top: calc((1.6em - 10px) / 2); } /* beside the first line (re-check NOTE 12) */
    .proof ul { list-style: none; margin: 0; padding: 0; }
    .proof li { padding: 16px 20px; border-top: 1px solid var(--line); }
    .proof li:first-child { border-top: 0; }
    .proof .says, .proof .add, .who a span { text-wrap: balance; }
    .proof .says { color: var(--muted); }
    .proof .add { margin-top: 6px; }
    .choice { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; } /* at large text on a small phone the chips take their own lines */
    .choice span { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border-radius: 9px; font-weight: 700; white-space: nowrap; }
    .choice .yes { background: var(--primary); color: #fff; }
    .choice .no { box-shadow: inset 0 0 0 1px var(--line); color: var(--muted); }
    .cap { margin-top: 12px; color: #d5deea; }

    /* how it works */
    .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; counter-reset: s; }
    .steps li { counter-increment: s; }
    .steps h3::before { content: counter(s); display: inline-grid; place-items: center; width: 32px; height: 32px; margin-right: 12px; border-radius: 50%; background: var(--primary); color: #fff; }
    .steps p { margin-top: 4px; color: var(--muted); }
    @container (min-width: 54rem) { .steps { grid-template-columns: repeat(3, 1fr); gap: 32px; } }

    /* pricing: the AR Pass is the focal point (founder 11/20/2026: a soft orange glow and "Best value") */
    .prices { display: grid; gap: 16px; }
    @container (min-width: 54rem) { .prices { grid-template-columns: 1fr 1fr; gap: 20px; } }
    .price, .who a { min-width: 0; }
    .price { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px 24px; }
    .price.best { border: 2px solid var(--accent-strong); padding: 27px 23px; box-shadow: 0 0 0 4px rgba(245,158,11,.14), 0 10px 30px rgba(245,158,11,.28); }
    .price .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px; min-height: 30px; }
    .tag { display: inline-flex; align-items: center; min-height: 30px; padding: 0 12px; border-radius: 999px; background: var(--accent-strong); color: var(--ink); font-weight: 700; white-space: nowrap; }
    .amt { font-size: var(--fs-h2); font-weight: 700; line-height: 1.2; margin-top: 4px; }
    .price ul { margin: 16px 0 24px; padding-left: 20px; color: var(--muted); }
    .price li + li { margin-top: 8px; }
    .price .btn { margin-top: auto; align-self: stretch; }
    .note { margin-top: 20px; }

    /* find your page */
    .who { display: grid; gap: 12px; }
    @container (min-width: 54rem) { .who { grid-template-columns: 1fr 1fr; } }
    .who a { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 20px; border: 1px solid var(--line); border-radius: 12px; background: #fff; color: var(--ink); font-weight: 700; }
    .who a::after { content: "\2192"; color: var(--primary); }
    .who a:hover { border-color: var(--primary); text-decoration: none; }
    .org { margin-top: 20px; }

    /* pre-launch capture (local builds without the launch switch) */
    .start-cta { margin-top: 20px; display: grid; gap: 12px; max-width: 34rem; }
    .capture-form { display: grid; gap: 10px; }
    .capture-email { min-width: 0; font: inherit; padding: 13px 14px; border: 1.5px solid var(--line); border-radius: var(--radius-sm); }
    .hide { display: none !important; }
  </style>
  <script>
    // Pre-launch capture: returning from POST /waitlist with ?joined=1|err, show the outcome in place of or under the form.
    const joined = new URLSearchParams(location.search).get('joined');
    if (joined) {
      const done = document.getElementById('captureDone');
      const err = document.getElementById('captureErr');
      const form = document.querySelector('.capture-form');
      if (joined === '1' && done) {
        done.classList.remove('hide');
        document.getElementById('captureGift')?.classList.remove('hide');
        if (form instanceof HTMLElement) form.style.display = 'none';
      }
      else if (err) { err.classList.remove('hide'); }
    }
  </script>
</Base>
