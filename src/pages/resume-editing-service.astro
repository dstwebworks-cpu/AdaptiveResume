---
import Base from '../layouts/Base.astro';
// "resume editing service" landing page (09/09 wave 8). Keyword Planner 07/29-07/30:
// ~500/mo, Low competition, $14.14 top-of-page bid. Model: resume-writing-service.astro
// (structure, capture form, pricing, make-it-right line, styles reproduced; content changed to the
// editing intent). A searcher for "editing" already has a resume and wants it improved.
// This page says plainly what we do (rebuild from confirmed facts) and what we are not
// (no human editor, no proofreader, no marked-up file). Own capture source
// (source=editing-service-page). Pre-launch CTA = list only; LAUNCHED mirrors index.astro.
const LAUNCHED = import.meta.env.PUBLIC_LAUNCHED === '1';
const appUrl = import.meta.env.PUBLIC_APP_URL
  ?? (import.meta.env.PROD ? 'https://app.adaptiveresume.com' : 'http://localhost:5173');
const waitlistAction = appUrl + '/waitlist'; // plain form POST — the app 303s back here
const site = Astro.site ?? new URL('https://adaptiveresume.com');
const faq = [
  { q: 'Will you keep my format?',
    a: "No, and that is on purpose. You get a rebuilt file, not your old file with edits in it. The finished resume is single-column, uses tabs instead of tables (so the text reads in order), has standard section headings, and carries no photo or graphics, because that is what hiring software reads cleanly. Your content is what carries over: every line you confirmed, in your words. If your current layout uses columns, text boxes, or a photo, our free guide on resume format for screening software explains what breaks and why." },
  { q: 'Do you fix typos?',
    a: "Not the way a proofreader does. Nobody reads your old file and corrects it; there is no human editor and no spelling pass on the file you upload. What happens instead: we rebuild the resume from your history and the lines you confirm, and you see the finished resume before you download it. There is no spelling pass on the file you upload. If a line comes out wrong, edit it or leave a note and we redo that line from your note. If you want a human to proofread the finished file afterward, that is a fine thing to do, and it is not something we sell." },
  { q: 'Do you add things?',
    a: "Only what you confirm. We work backwards from what your jobs actually involved and propose the tools, standards, credentials, and scope that are not on the page yet, one at a time, as questions. You confirm the ones that are really yours, edit the wording, or skip. If you skip something, it never appears. Nothing goes on the page that you did not confirm, so there is nothing on it you cannot stand behind in an interview." },
  { q: 'How long does it take?',
    a: "It goes in stages, and most of the elapsed time is yours. First you upload your resume, and your LinkedIn resume export if you have one. Then findings appear one at a time and you confirm, edit, or skip each. Then you see what screening software reads from the finished file, and you download it. There is no editor to wait on and no revision round to schedule. If a line comes out wrong, you edit it or leave a note and we redo that line from your note, right then." },
  { q: 'Can I buy from any state?',
    a: "Almost. Right now we can't sell resume builds to residents of New Jersey or Illinois. Those two states have laws written for job-placement agencies that can also reach paid resume help, and we're staying on the safe side until that's settled. The free scan and the demo work everywhere in the United States, and if you're in one of those states we'll tell you the day this changes." },
];
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
    { '@type': 'ListItem', position: 2, name: 'Resume editing service' },
  ],
};
---
<Base
  title="Resume Editing Service: Rebuilt From Your Facts, $49"
  description="A resume editing service with no human editor: upload your resume, we find what it undersells, you confirm every line, and get a clean rebuilt file. $49, once."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">A resume editing service that fixes what the resume says, not just how it reads</p>
        <h1>A <span class="hl">resume editing service</span> that rebuilds from your facts.</h1>
        <p class="tagline">Your resume reads fine. The problem is not the grammar. It is what never got written down.</p>
        <p class="lede">
          Upload the resume you have. Nobody here reads it and moves commas. Instead we work backwards from what each job actually involved and ask you, one finding at a time, about the systems, standards, credentials, and scope it leaves out. You confirm what is really yours, in your words, or skip it. What you get back is a rebuilt file that screening software reads in order, built only from lines you approved.
        </p>
        <div class="cta-row">
          {LAUNCHED
            ? <a class="btn btn-amber btn-lg" href="#get-started">Upload your resume &amp; get started</a>
            : <a class="btn btn-amber btn-lg" href="#get-started">Join the list — 25% off at launch</a>}
          <a class="btn btn-ghost btn-lg" href="/demo/">Not sure yet? Try the demo first</a>
        </div>
        <ul class="pills">
          <li class="pill">Nothing made up</li>
          <li class="pill">You approve every line</li>
          <li class="pill">One-time payment — no subscription</li>
        </ul>
      </div>

      <div class="familiar" aria-label="Why people come here for a resume editing service">
        <p class="familiar-label">Two kinds of people land on this page:</p>
        <div class="fcard">
          <b>"My resume is close. It just needs a good edit."</b>
          <p>Usually the grammar is fine. What is missing is the substance: the systems you ran, the
          size of what you handled, the credentials you hold. An edit does not add those. We find them
          with you, and you confirm each one.</p>
        </div>
        <div class="fcard">
          <b>"I paid for editing before and got my own file back with commas moved."</b>
          <p>That is what an edit does: it works with what is already on the page. It was never going to find what you left off. Bring that file. It
          is a starting point, and we finish what it started. If it was a full paid rewrite that went
          quiet, <a href="/fix/">start at Fix my resume</a> instead.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHAT EDITING FIXES, AND WHAT IT CANNOT ===== -->
  <section class="section alt">
    <div class="container">
      <p class="eyebrow">What "editing" fixes, and what it cannot</p>
      <h2>A resume that undersells needs facts, not commas.</h2>
      <div class="grid cols-2">
        <div class="card">
          <h3>1. What a typical edit fixes</h3>
          <p>Grammar, spelling, tense, wording, spacing. A tighter verb here, a shorter sentence there.
          Those are real fixes, and if that is all your resume needs, a proofreader is the right buy. We
          do not sell that, and we will not pretend to.</p>
        </div>
        <div class="card">
          <h3>2. What no edit can fix</h3>
          <p>An editor can only work with what is already on the page. If you never wrote down the
          scheduling system you ran, the safety standard you worked to, the crew you led, or the
          certification you renewed, no amount of editing puts it there. The line stays true and thin.</p>
        </div>
        <div class="card">
          <h3>3. What we do instead</h3>
          <p>We work backwards from what each job actually involved and propose what is missing, one
          finding at a time, as a question to you. You confirm, edit, or skip each one. Nothing lands
          without your say-so. If a line reads wrong, edit it directly or leave a note and we redo that
          line from your note.</p>
        </div>
        <div class="card">
          <h3>4. What you get back</h3>
          <p>Not your file with tracked changes. A rebuilt resume: single-column, tabs instead of tables,
          standard headings, no photo or graphics, plain letters and numbers with no symbols. Before you are done, you see what
          hiring software actually extracts from it. Our free guide on
          <a href="/guides/resume-format-for-ats/">resume format for screening software</a> explains why
          those choices matter.</p>
        </div>
      </div>
      <p class="muted" style="margin-top:12px">Not sure this is your page? If your resume is old, short,
      and self-written, see <a href="/rewrite-my-resume/">Rewrite my resume</a>. If it is years behind
      your current job, see <a href="/update-my-resume/">Update my resume</a>. If it looks dated and you
      want it to say more, see <a href="/resume-makeover/">Resume makeover</a>. This page is for a resume
      you already keep current and want to say more with.</p>
    </div>
  </section>

  <!-- ===== BEFORE -> AFTER ===== -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">What the difference looks like</p>
      <h2>An edited line, next to a rebuilt line.</h2>
      <div class="grid cols-2">
        <div class="card">
          <h3>Before: the line after a typical edit</h3>
          <p class="muted">"Managed inventory and ordered supplies for the department. Handled vendor calls."</p>
          <p class="muted">Tighter than the original "responsible for managing inventory," and just as
          empty. Nothing was added, because an edit cannot add what was never written down.</p>
        </div>
        <div class="card">
          <h3>After: rebuilt, every line confirmed by the person</h3>
          <p>"Ran inventory for a [N]-person department in [system]: weekly cycle counts, reorder points, and supplier orders worth [$N] a month; cut stockouts to [N] in [N] months; negotiated delivery windows with [N] vendors so the floor never waited on parts."</p>
        </div>
      </div>
      <p class="muted" style="margin-top:12px">Every bracket is yours to fill: [N] is your number, [system] is the one you actually used, and we ask instead of guessing. The edit on the left tightened the wording. The rebuild on the right changed what a reader knows about you, and you confirmed every piece of it.</p>
    </div>
  </section>

  <!-- ===== TYPICAL EDITING SERVICES VS. HERE ===== -->
  <section class="section alt">
    <div class="container">
      <p class="eyebrow">Read before you buy anywhere</p>
      <h2>Typical editing and proofreading services, next to us.</h2>
      <p class="lede" style="max-width:62ch">Neither column is a trick. They are different jobs. Ask these
      questions of anyone, including us, and buy the one that matches what your resume actually needs.</p>
      <div class="grid cols-2">
        <div class="card qcard">
          <h3>What gets changed?</h3>
          <p>Typical editing: grammar, wording, and layout. Your facts stay exactly as you wrote them,
          including the ones you left out.</p>
          <p class="ours"><b>Here:</b> the facts. We propose what your work involved that is not on the page. You confirm each one. Wording is yours to edit on any line.</p>
        </div>
        <div class="card qcard">
          <h3>Who touches my file?</h3>
          <p>Typical editing: a human editor reads your document and sends it back marked up, often with
          tracked changes and a round or two of back-and-forth.</p>
          <p class="ours"><b>Here:</b> no human editor, no proofreader, no marked-up file. Software works backwards through your history and asks you questions. The only person who reads and approves each line is you.</p>
        </div>
        <div class="card qcard">
          <h3>What do I get back?</h3>
          <p>Typical editing: your own file, corrected. Same layout, same length, same facts.</p>
          <p class="ours"><b>Here:</b> a rebuilt file in a format screening software reads cleanly, and you see what that software extracts from it before you are done.</p>
        </div>
        <div class="card qcard">
          <h3>Is it a subscription or per round?</h3>
          <p>Typical editing: sometimes priced per page, per round, or on a monthly plan. Check before you enter a card.</p>
          <p class="ours"><b>Here:</b> no. $49 or $149, one-time. Nothing to cancel. Revisions are not a negotiation: edit the line, or leave a note and we redo it from your note.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section class="section" id="pricing">
    <div class="container">
      <p class="eyebrow">What you get</p>
      <h2>One-time payment. No subscription. Nothing to cancel.</h2>
      <div class="grid cols-2">
        <div class="card price">
          <h3>Base build</h3>
          <p class="amount">$49<span>one-time</span></p>
          <p class="muted">The complete, honest, machine-readable rebuild of your one resume — everything
          you've earned, finally on paper.</p>
          <ul class="ticks">
            <li>Your resume and LinkedIn resume export (the PDF with your work history) dug through together for what you left off</li>
            <li>You confirm, edit, or skip every finding — nothing made up</li>
            <li>Edit any line, or leave a note and we redo it from your note</li>
            <li>You see what screening software reads from the finished file</li>
          </ul>
        </div>
        <div class="card price featured">
          <span class="tag-premium">Aimed at one posting</span>
          <h3>Targeted build</h3>
          <p class="amount">$149<span>one-time</span></p>
          <p class="muted">Everything in the base build, aimed at one specific job posting you bring us.</p>
          <ul class="ticks">
            <li>Your experience translated into that field's language</li>
            <li>25 interview questions for that role</li>
            <li>The full breakdown of the targeted build is on the <a href="/#pricing">pricing page</a></li>
          </ul>
        </div>
      </div>
      <p class="muted small" style="text-align:center">Join the list before launch and your first build is 25% off. You stay the author the whole way.
      Aiming at one posting and want to do the tailoring yourself first? Our free guide on
      <a href="/guides/tailor-resume-to-job-description/">tailoring a resume to a job description</a> shows how.</p>
    </div>
  </section>

  <!-- ===== GET STARTED (capture) ===== -->
  <section class="section alt" id="get-started">
    <div class="container narrow" style="text-align:center">
      {LAUNCHED
        ? <h2>Let's see what you've been leaving off.</h2>
        : <h2>We launch in October 2026 — don't pay full price</h2>}
      {LAUNCHED
        ? <p class="lede">Create your account, upload your resume, and we'll dig in together. You approve every line before anything lands.</p>
        : <p class="lede">Join the list before launch day — that's all it takes. <b>25% off your first
          build is locked in</b>, and our Role Skills Checklist (a ready-to-use Word worksheet) is yours
          the moment you join. When we're live, you bring your resume and we find what it left off.</p>}
      {LAUNCHED ? (
        <div class="cta-row" style="justify-content:center">
          <a class="btn btn-amber btn-lg" href={appUrl}>Create an account — get started today</a>
          <a class="btn btn-ghost btn-lg" href="/demo/">Try the demo first</a>
        </div>
      ) : (
        <>
          <form class="capture-form" method="post" action={waitlistAction}>
            <input type="text" name="fax_number" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
            <input type="hidden" name="source" value="editing-service-page" />
            <input type="hidden" name="redirect" value="/resume-editing-service/" />
            <input class="capture-email" type="email" name="email" required placeholder="you@example.com" aria-label="Your email address" />
            <button class="btn btn-amber btn-lg" type="submit">Join the list</button>
          </form>
          <p class="capture-note muted">Just your email — no account, no card. Your discount arrives with the launch email. No spam.</p>
          <p class="capture-done hide" id="captureDone">You're on the list, and your 25% is locked in. We'll tell you the moment we're live.</p>
          <a class="btn btn-premium hide" id="captureGift" href="/templates/role-skills-checklist.docx" download>Download your Role Skills Checklist</a>
          <p class="capture-err hide" id="captureErr">That email didn't look right — mind trying it again?</p>
          <p class="muted small"><a href="/demo/">Not sure yet? Try the demo first</a> — a sample review, no sign-up.</p>
        </>
      )}
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section">
    <div class="container narrow">
      <h2>Common questions</h2>
      {faq.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
      <p class="muted small">We don't name or review specific companies. If an editing service treated you well, wonderful — this page is for anyone whose resume needs more than an edit. If a paid rewrite went wrong, <a href="/fix/">start at Fix my resume</a>.</p>
      <p class="muted small" style="text-align:center">If your review genuinely finds nothing for you, we'll make it right — see the <a href="/terms/">Terms</a> for the plain-language details.</p>
    </div>
  </section>

  <script>
    // Returning from POST /waitlist (?joined=1|err). No-JS visitors still landed on
    // #get-started via the 303; this only swaps the form for the confirmation + gift.
    const q = new URLSearchParams(location.search);
    const show = (id: string) => document.getElementById(id)?.classList.remove('hide');
    const hideCapture = () => {
      const form = document.querySelector('.capture-form');
      if (form instanceof HTMLElement) form.style.display = 'none';
      document.querySelector('.capture-note')?.classList.add('hide');
    };
    if (q.get('joined') === '1') {         // just joined -> confirmation + gift
      show('captureDone'); show('captureGift'); hideCapture();
    } else if (q.get('joined')) {
      show('captureErr');
    }
  </script>

  <style>
    .hero { padding: 58px 0 48px; background:
      radial-gradient(1100px 460px at 72% -12%, #d8e5fa, transparent 70%),
      radial-gradient(760px 380px at 4% 112%, #fdf0dc, transparent 62%),
      var(--bg); }
    .hero-grid { display: grid; gap: 36px; align-items: center; }
    @media (min-width: 960px) { .hero-grid { grid-template-columns: 1.05fr 0.95fr; } }
    .tagline { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 700; color: var(--ink); margin: 0 0 12px; }
    .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin: 22px 0 18px; }
    .pills { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 0; }

    .familiar { display: grid; gap: 14px; }
    .familiar-label { margin: 0 0 -2px; font-weight: 700; color: var(--muted); font-size: .95rem; }
    .fcard { background: var(--card); border: 1px solid var(--line); border-left: 4px solid var(--accent-strong);
      border-radius: var(--radius); padding: 16px 18px; box-shadow: var(--shadow); }
    .fcard b { display: block; margin-bottom: 4px; }
    .fcard p { margin: 0; color: var(--muted); font-size: .95rem; }

    .qcard p { margin: 0 0 8px; color: var(--muted); }
    .qcard .ours { margin: 0; color: var(--ink); }

    .price { display: flex; flex-direction: column; }
    .price.featured { border-color: #cbb4f0; box-shadow: 0 0 0 3px #ece2fb, var(--shadow-lg); position: relative; }
    .amount { font-size: 2.2rem; font-weight: 800; color: var(--ink); margin: 4px 0 6px; }
    .amount span { font-size: .95rem; font-weight: 600; color: var(--muted); margin-left: 8px; }
    .ticks { list-style: none; padding: 0; margin: 14px 0 6px; }
    .ticks li { padding-left: 18px; position: relative; margin-bottom: 9px; color: var(--ink-soft); }
    .ticks li::before { content: ""; position: absolute; left: 0; top: .55em; width: 7px; height: 7px; border-radius: 50%; background: var(--true); }

    .container.narrow { max-width: 760px; }
    .capture-form { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
    .capture-email { flex: 1 1 240px; max-width: 360px; font-family: inherit; font-size: 1rem; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius-sm); }
    .capture-note { margin-top: 12px; font-size: .95rem; }
    .capture-done { color: var(--true); font-weight: 700; }
    .hide { display: none; }
    .small { font-size: .85rem; margin-top: 18px; }

    .faq-item { border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 12px 16px; margin: 10px 0; background: var(--card); }
    .faq-item summary { cursor: pointer; font-weight: 700; color: var(--ink); }
    .faq-item p { margin: 10px 0 2px; color: var(--ink-soft); }
  </style>
</Base>
