---
import Base from '../layouts/Base.astro';
// "Resume makeover service" landing page (09/02 wave). The live exact-match ad group
// lands on the homepage today; this page message-matches it. Own capture form
// (source=makeover-page) so the page measures itself, mirroring /fix/.
// Pre-launch (default): CTAs are email capture. Set PUBLIC_LAUNCHED=1 at build to
// flip the CTAs to the app, exactly as index.astro does.
const LAUNCHED = import.meta.env.PUBLIC_LAUNCHED === '1';
const appUrl = import.meta.env.PUBLIC_APP_URL
  ?? (import.meta.env.PROD ? 'https://app.adaptiveresume.com' : 'http://localhost:5173');
const waitlistAction = appUrl + '/waitlist'; // plain form POST — the app 303s back here
const site = Astro.site ?? new URL('https://adaptiveresume.com');
const faq = [
  { q: 'What does a resume makeover actually change here?',
    a: "What the resume says, first. We work backwards from what your work actually involved and show you the tools, standards, credentials and scope you left off — one at a time. You confirm, edit, or skip each one. Then the filler phrases come out, and the finished file goes into a clean single-column layout that screening software reads correctly. New look, yes — but built on new substance." },
  { q: 'Can I keep my two-column template or my photo?',
    a: "We'll be honest: we hand back a single-column file with no photo. Screening software reads text, not pictures, and a two-column layout can scramble the reading order so your dates end up next to the wrong job. You can see for yourself what the software pulls from the finished file before you're done." },
  { q: 'Is anything made up?',
    a: "No. Nothing goes on the page you didn't confirm. If we suggest a tool or a credential your work involved and it isn't really yours, you skip it and it's gone. If a line reads wrong, edit it directly or leave a note and we redo that line from your note." },
  { q: 'What does it cost, and what is the difference between $49 and $149?',
    a: '$49, one-time, is the complete, honest, machine-readable rebuild of your one resume — the makeover. $149, one-time, is the targeted build aimed at one specific job posting: the same rebuild in that posting\'s language, plus 25 interview questions for that role (full breakdown on the pricing page). No subscription. Join the list before launch and your first build is 25% off.' },
];
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
    { '@type': 'ListItem', position: 2, name: 'Resume makeover' },
  ],
};
---
<Base
  title="Resume Makeover Service — Substance First, Then Format"
  description="A resume makeover service that changes what your resume says, not just how it looks: real skills you left off, filler out, a file screening software reads. $49."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">A resume makeover service that starts with the words</p>
        <h1>A <span class="hl">resume makeover</span> that changes what it says — not just the font.</h1>
        <p class="tagline">Dated, flat, full of "results-oriented team player"? A new template won't fix that. New substance will.</p>
        <p class="lede">
          Upload the resume you have. We work backwards from what your work actually involved and show
          you the real tools, standards and credentials you left off — you confirm each one. The empty
          phrases come out. What goes back on the page is specific, true, and yours. Then we put it in a
          clean single-column file and show you what the screening software reads from it.
        </p>
        <div class="cta-row">
          {LAUNCHED
            ? <a class="btn btn-amber btn-lg" href={appUrl}>Upload your resume &amp; get started</a>
            : <a class="btn btn-amber btn-lg" href="#get-started">Join the list — 25% off at launch</a>}
          <a class="btn btn-ghost btn-lg" href="/demo/">See the review on a sample profile</a>
        </div>
        <ul class="pills">
          <li class="pill">Nothing made up</li>
          <li class="pill">You approve every line</li>
          <li class="pill">One-time payment — no subscription</li>
        </ul>
      </div>

      <div class="familiar" aria-label="Common signs a resume needs a makeover">
        <p class="familiar-label">Sound familiar? The resumes that come to us for a makeover:</p>
        <div class="fcard">
          <b>"It reads like everyone else's."</b>
          <p>"Hard worker." "Team player." "Proven track record." Recruiters tend to skim right past these — they say nothing about what you actually did.</p>
        </div>
        <div class="fcard">
          <b>"It's a template from years ago."</b>
          <p>Two columns, a photo, a skills bar chart. It looked sharp on screen. To screening software, a lot of it reads as nothing at all.</p>
        </div>
        <div class="fcard">
          <b>"The good stuff isn't even on it."</b>
          <p>The system you ran, the safety standard you followed, the people you trained — it was all real work, and none of it made the page.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHAT A REAL MAKEOVER CHANGES ===== -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">What a real makeover changes</p>
      <h2>Substance first. Then the format.</h2>
      <div class="grid cols-2">
        <div class="card">
          <h3>What you left off goes back on</h3>
          <p>We work backwards from your real experience — the tools, standards, training and scope
          your work involved that never made it onto the page. Each finding is shown to you first.
          You confirm what's really yours, in your words. Skip anything that isn't.</p>
        </div>
        <div class="card">
          <h3>Filler comes out</h3>
          <p>"Results-oriented." "Team player." "Hard worker." "Responsible for various duties." These
          are the lines recruiters tend to skim past, because they could be about anyone. Each one gets replaced
          with something specific and true — or simply removed.</p>
        </div>
        <div class="card">
          <h3>A format the screening software can read</h3>
          <p>Single column. Real text, not pictures. Standard headings. Dates next to the right job.
          Before you're done, you see what the software actually pulls from the finished file. Curious
          what really matters and what's myth? <a href="/guides/resume-format-for-ats/">Our plain-English guide to resume format for screening software</a> walks through it.</p>
        </div>
        <div class="card">
          <h3>Your voice, not a template's</h3>
          <p>No stock phrasing swapped in for yours. Edit any line directly, or leave a note —
          "I led this, I didn't assist" — and we redo that line from your note. You stay the author
          the whole way.</p>
        </div>
      </div>
      <p class="muted scan-note">Also at launch: a free format check on your own file — images, fonts,
      tables and columns, hidden text, filler phrases. No AI, nothing stored. Use it whether or not you
      buy anything.</p>
    </div>
  </section>

  <!-- ===== BEFORE / AFTER ===== -->
  <section class="section alt">
    <div class="container">
      <p class="eyebrow">What the makeover looks like</p>
      <h2>One filler line, made specific and true</h2>
      <div class="grid cols-2">
        <div class="card">
          <h3>Before</h3>
          <p class="muted">"Results-oriented team player and hard worker with a proven track record of
          success in a fast-paced environment."</p>
        </div>
        <div class="card">
          <h3>After — every item confirmed by the person</h3>
          <p>"[Title] at [employer], [N] years. Preventive maintenance on [N] machines, OSHA
          lockout/tagout (LOTO) compliance, [system] troubleshooting, trained [N] new hires on
          standard work procedures."</p>
        </div>
      </div>
      <p class="muted" style="margin-top:12px">The bracketed parts are yours — your title, your
      numbers, your systems. We never add a number you didn't give us. The first line could be about
      anyone. The second could only be about you — and that's the whole makeover.</p>
    </div>
  </section>

  <!-- ===== PRICING ANCHOR ===== -->
  <section class="section">
    <div class="container priceband">
      <p class="eyebrow">One-time payment. No subscription.</p>
      <h2>Honest pricing for a real makeover.</h2>
      <p class="lede">$49 for the complete, honest, machine-readable rebuild of your one resume. Or $149
      for the targeted build aimed at one specific job posting: the rebuild in that posting's language
      plus 25 interview questions for the role (full breakdown on the pricing page). Join the list before launch day and your first build is 25% off.</p>
      <div class="cta-row" style="justify-content:center">
        {LAUNCHED
          ? <a class="btn btn-primary btn-lg" href={appUrl}>Get started</a>
          : <a class="btn btn-primary btn-lg" href="#get-started">Lock in 25% off</a>}
      </div>
      <p class="muted small">If a line is wrong, we redo it from your note. One-time payment — no revision haggling. Paid for a makeover already and got a template back? <a href="/fix/">Start at Fix my resume</a>.</p>
      <p class="muted small" style="text-align:center">If your review genuinely finds nothing for you, we'll make it right — see the <a href="/terms/">Terms</a> for the plain-language details.</p>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section alt">
    <div class="container narrow">
      <h2>Common questions</h2>
      {faq.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ===== GET STARTED (capture) ===== -->
  <section class="section" id="get-started">
    <div class="container narrow" style="text-align:center">
      {LAUNCHED ? (
        <>
          <h2>Ready for the makeover?</h2>
          <p class="lede">Create your account, upload the resume you have, and we'll dig in together.
          You approve every line before anything lands.</p>
          <div class="cta-row" style="justify-content:center">
            <a class="btn btn-amber btn-lg" href={appUrl}>Upload your resume &amp; get started</a>
          </div>
          <p class="muted">Already have an account? <a href={appUrl + '/login'}>Sign in</a></p>
        </>
      ) : (
        <>
          <h2>We launch in October 2026 — be first in line</h2>
          <p class="lede">Join the list before launch day — that's all it takes. <b>25% off your first
          build is locked in</b>, and our ATS Readability Checklist (ATS is the software that reads your resume first; the checklist is a ready-to-use Word worksheet for
          checking your current file today) is yours the moment you join. We'll tell you the moment
          we're live. No spam.</p>
          <form class="capture-form" method="post" action={waitlistAction}>
            <input type="text" name="fax_number" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
            <input type="hidden" name="source" value="makeover-page" />
            <input type="hidden" name="redirect" value="/resume-makeover/" />
            <input class="capture-email" type="email" name="email" required placeholder="you@example.com" aria-label="Your email address" />
            <button class="btn btn-amber btn-lg" type="submit">Join the list</button>
          </form>
          <p class="capture-note muted">Just your email — no account, no card. Your discount arrives with the launch email.</p>
          <p class="capture-done hide" id="captureDone">You're on the list, and your 25% is locked in. We'll tell you the moment we're live.</p>
          <a class="btn btn-premium hide" id="captureGift" href="/templates/ats-readability-checklist.docx" download>Download your ATS Readability Checklist</a>
          <p class="capture-err hide" id="captureErr">That email didn't look right — mind trying it again?</p>
        </>
      )}
    </div>
  </section>

  <script>
    // Returning from POST /waitlist (?joined=1|err). No-JS visitors still landed on
    // #get-started via the 303; this only swaps the form for the confirmation + gift.
    const joined = new URLSearchParams(location.search).get('joined');
    if (joined) {
      const done = document.getElementById('captureDone');
      const err = document.getElementById('captureErr');
      const form = document.querySelector('.capture-form');
      if (joined === '1' && done) {
        done.classList.remove('hide');
        document.getElementById('captureGift')?.classList.remove('hide');
        document.querySelector('.capture-note')?.classList.add('hide');
        if (form instanceof HTMLElement) form.style.display = 'none';
      }
      else if (err) { err.classList.remove('hide'); }
    }
  </script>

  <style>
    .hero { padding: 58px 0 48px; background:
      radial-gradient(1100px 460px at 72% -12%, #d8e5fa, transparent 70%),
      radial-gradient(760px 380px at 4% 112%, #fdf0dc, transparent 62%),
      var(--bg); }
    .hero-grid { display: grid; gap: 36px; align-items: center; }
    @media (min-width: 960px) { .hero-grid { grid-template-columns: 1.05fr 0.95fr; } }
    .tagline { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 700; color: var(--ink); margin: 0 0 12px; }
    .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin: 22px 0 18px; }
    .pills { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 0; }

    .familiar { display: grid; gap: 14px; }
    .familiar-label { margin: 0 0 -2px; font-weight: 700; color: var(--muted); font-size: .95rem; }
    .fcard { background: var(--card); border: 1px solid var(--line); border-left: 4px solid var(--accent-strong);
      border-radius: var(--radius); padding: 16px 18px; box-shadow: var(--shadow); }
    .fcard b { display: block; margin-bottom: 4px; }
    .fcard p { margin: 0; color: var(--muted); font-size: .95rem; }

    .scan-note { margin: 22px auto 0; max-width: 72ch; font-size: .95rem; }

    .container.narrow { max-width: 760px; }
    .capture-form { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
    .capture-email { flex: 1 1 240px; max-width: 360px; font-family: inherit; font-size: 1rem; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius-sm); }
    .capture-note { margin-top: 12px; font-size: .95rem; }
    .capture-done { color: var(--true); font-weight: 700; }
    .hide { display: none; }

    .priceband { text-align: center; max-width: 760px; }
    .priceband .lede { margin-left: auto; margin-right: auto; max-width: 60ch; }
    .small { font-size: .85rem; margin-top: 18px; }

    .faq-item { border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 12px 16px; margin: 10px 0; background: var(--bg); }
    .faq-item summary { cursor: pointer; font-weight: 700; color: var(--ink); }
    .faq-item p { margin: 10px 0 2px; color: var(--ink-soft); }
  </style>
</Base>
