---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fieldOf, demoSampleFor, SAMPLE_LABEL, NEAR } from '../../lib/guideFrontDoor';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => !g.data.draft);
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g, all: guides } }));
}

const { guide, all } = Astro.props;
const { Content } = await render(guide);
// Template gate posts to the app's waitlist (plain form POST, 303s back here with
// ?joined=1 and the download unlocked). Prod default = real app origin (07/27 rule).
const appUrl = import.meta.env.PUBLIC_APP_URL
  ?? (import.meta.env.PROD ? 'https://app.adaptiveresume.com' : 'http://localhost:5173');
const waitlistAction = appUrl + '/waitlist';
const segLabel = guide.data.segment === 'organizations' ? 'For organizations' : 'For job seekers';
// Article structured data (SEO audit chunk, 07/29). UTC getters — coerced dates are
// UTC midnight and local getters would shift the shown day in US timezones.
const site = Astro.site ?? new URL('https://adaptiveresume.com');
const fmtDate = (d: Date) => `${String(d.getUTCMonth() + 1).padStart(2, '0')}/${String(d.getUTCDate()).padStart(2, '0')}/${d.getUTCFullYear()}`;
const pub = guide.data.pubDate;
const upd = guide.data.updatedDate;
// Per-guide branded card (scripts/generate-guide-cards.mjs) — the on-page hero, the
// og/social preview, AND the Article schema image, from one generated PNG per slug.
const cardPath = `/img/guides/${guide.id}.png`;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: pub.toISOString().slice(0, 10),
  dateModified: (upd ?? pub).toISOString().slice(0, 10),
  image: new URL(cardPath, site).href,
  author: { '@type': 'Organization', name: 'AdaptiveResume' },
  publisher: { '@type': 'Organization', name: 'AdaptiveResume',
    logo: { '@type': 'ImageObject', url: new URL('/img/social-card-1200x1200.png', site).href } },
  mainEntityOfPage: new URL(`/guides/${guide.id}/`, site).href,
};
// FAQPage schema only when the guide carries real Q&As (must mirror visible content).
const faqLd = guide.data.faq?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.data.faq.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
// Breadcrumbs (08/06 audit): Home > Guides > this guide — mirrors the visible eyebrow trail.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides', site).href },
    { '@type': 'ListItem', position: 3, name: guide.data.title },
  ],
};
// SERP title/meta: seoTitle/seoDescription overrides (<=60 / <=160); the " — AdaptiveResume"
// suffix is GONE on guides — it pushed 20+ titles past 60 chars (08/06 audit #1 systemic),
// and Google shows the site name from Organization schema anyway.
const pageTitle = guide.data.seoTitle ?? guide.data.title;
const metaDescription = guide.data.seoDescription ?? guide.data.description;
// Related picker (08/06 audit #2 systemic): the old same-segment+order sort sent every
// guide's links to the SAME three legacy guides, leaving 13 pages with one inbound link.
// Rotating the same-segment ring by this guide's own position spreads inbound links
// across the whole collection deterministically (stable per build — no random churn).
const ring = all
  .filter((g) => g.id !== guide.id)
  .sort((a, b) =>
    (a.data.segment === guide.data.segment ? 0 : 1) - (b.data.segment === guide.data.segment ? 0 : 1) ||
    a.data.order - b.data.order || a.id.localeCompare(b.id),
  );
const selfIdx = Math.max(0, all.findIndex((g) => g.id === guide.id));
const spread = ring.length <= 3 ? ring
  : [0, 1, 2].map((i) => ring[(selfIdx + i * Math.floor(ring.length / 3)) % ring.length]);
// Front door (founder 10/30-10/31/2026, Version 3 chosen after the side-by-side walk): the free check is offered
// after the first paragraph, before the middle section and in the end panel; the $29 build is described as the step
// that follows the check; the demo sample and "Keep reading" match the guide's field. Each line promises only what
// its own step does (founder rule 10/31/2026). No bottom bar: the sticky header already carries the button.
const isOrg = guide.data.segment === 'organizations';
// Organizations guides are one group of their own; job-seeker guides group by field.
const fieldFor = (g: typeof guide) => (g.data.segment === 'organizations' ? 'general' : fieldOf(g.id));
const field = fieldFor(guide);
const sample = demoSampleFor(guide.id, field);
const checkUrl = appUrl + '/?start=check';
const passGuide = guide.data.cta.label.includes('$99');
// Same field first (rotated by this guide's position so inbound links spread across the field), then its
// nearest fields, then the spread above; always the same audience.
const inField = (fl: string) => all.filter((g) => g.id !== guide.id && g.data.segment === guide.data.segment && fieldFor(g) === fl);
// Peers in a fixed order; each guide shows the next two after itself, so every guide in a field is linked by two others.
const peers = all.filter((g) => g.data.segment === guide.data.segment && fieldFor(g) === field).sort((x, y) => x.id.localeCompare(y.id));
const me = peers.findIndex((g) => g.id === guide.id);
const ownNext = peers.length > 1 ? [1, 2, 3].map((i) => peers[(me + i) % peers.length]).filter((g) => g.id !== guide.id) : [];
const near = NEAR[field].flatMap(inField);
// All three from the same field when it has them, then its nearest fields, then the general how-to guides, then the
// same-audience spread as a last resort (recheck 10/31 F4: a site-wide third slot sent CNA readers to data analyst).
const general = inField('general');
const sameAudience = [...spread, ...ring].filter((g) => g.data.segment === guide.data.segment);
const related = [...ownNext, ...near, ...general, ...sameAudience].filter((g, i, arr) => arr.indexOf(g) === i && g.id !== guide.id).slice(0, 3);
---
<Base title={pageTitle} description={metaDescription} ogImage={cardPath}>
  <article class="section">
    <div class="container narrow">
      <p class="eyebrow"><a href="/guides/">Guides</a> · {segLabel}</p>
      <h1>{guide.data.title}</h1>
      <p class="lede">{guide.data.description}</p>
      <p class="muted dateline">Published {fmtDate(pub)}{upd && ` · Updated ${fmtDate(upd)}`}</p>
      <img class="guide-hero" src={cardPath} alt={guide.data.title} width="1200" height="628" loading="eager" fetchpriority="high" />
      {!isOrg && (
        <aside class="fd-touch" id="fd-t1">
          <p>Want to know if screening software can read your resume? Upload it, and we'll run up to 12 checks that software cares about, such as your contact details, dates and section headings. It's free, and you don't need an account. <a href={checkUrl}>Check my resume free</a></p>
        </aside>
      )}
      <script type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />
      <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
      {faqLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />}

      <div class="prose">
        <Content />
      </div>
      {!isOrg && (
        <aside class="fd-touch" id="fd-t2">
          <p>Before you change your resume, find out how screening software reads it today. Our free check covers up to 12 things that software looks for. <a href={checkUrl}>Check my resume free</a></p>
        </aside>
      )}

      {guide.data.faq?.length && (
        <div class="faq-block">
          <h2>Common questions</h2>
          {guide.data.faq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      )}

      {/* product panel: the free check leads; the paid build is the second line */}
      {isOrg ? (
        <div class="card cta-card" id="fd-end">
          <h3>Want to see this working for the people you serve?</h3>
          <p>Send us your candidates' resumes. We find the skills, standards, and training each person left off, and your reviewers confirm anything that looks like a license or certification before it goes on a resume. You pay for each candidate we work on. Tell us how many people you serve, and we'll send you a per-candidate price.</p>
          <a class="btn btn-primary btn-lg" href="/business/#quote">Request a per-candidate quote</a>
          <p class="cta-links muted"><a href="/business/">See how it works for organizations</a></p>
        </div>
      ) : (
        <div class="card cta-card" id="fd-end">
          <h3>Start with a free check of your own resume.</h3>
          <p>Upload it, and we'll run up to 12 checks screening software cares about, such as your contact details, dates and section headings. You'll see which ones pass and which need attention. It's free, and you don't need an account.</p>
          <a class="btn btn-primary btn-lg" href={checkUrl}>Check my resume free</a>
          <p class="fd-paid">When your check is done, you can choose the full resume build. For $29, we ask you about your work to find what your resume leaves out, and your final resume is built only from what you brought us and what you approve. There's no subscription and no auto-renewal. <a href="/#pricing">See what the $29 build includes</a></p>
          {passGuide && <p class="cta-links muted">If you are applying to several jobs, the AR Pass is $99 for up to 10 builds aimed at job postings, and you have 90 days to use them.</p>}
          <p class="cta-links muted">
            {sample
              ? <a href={'/demo/?p=' + sample}>{'See it work on ' + SAMPLE_LABEL[sample] + ', no sign-up needed'}</a>
              : <a href="/demo/">See it work on a sample resume, no sign-up needed</a>}
          </p>
          {field !== 'layoff' && <p class="cta-links muted">If you paid a resume service and got a template back, <a href="/fix/">start at Fix my resume</a>.</p>}
        </div>
      )}

      <!-- email-gated giveaway -->
      <div class="card giveaway" id="giveaway">
        <span class="tag-premium">Free download</span>
        <h3>{guide.data.giveaway.name}</h3>
        <p class="muted">Enter your email to unlock the download. Buy within 30 days with this same email and <b>save 25% on your purchase</b>. We'll send an occasional useful note.</p>
        <form class="gate" method="post" action={waitlistAction}>
          <input type="text" name="fax_number" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
          <input type="hidden" name="source" value={'guide-' + guide.id} />
          <input type="hidden" name="redirect" value={'/guides/' + guide.id + '/'} />
          <input type="email" name="email" required placeholder="you@email.com" aria-label="Email address" />
          <button class="btn btn-primary" type="submit">Unlock the download</button>
        </form>
        <a class="dl btn btn-premium" hidden href={guide.data.giveaway.file} download>Download the {guide.data.giveaway.name}</a>
        <p class="gate-note muted" hidden>Your download is ready above. Your 25% off is good for 30 days.</p>
        <p class="gate-err muted" hidden>That email address doesn't look right. Please check it and try again.</p>
      </div>

      <!-- keep reading -->
      <div class="related">
        <h3>Keep reading</h3>
        <div class="grid cols-3">
          {related.map((g) => (
            <a class="card rcard" href={`/guides/${g.id}/`}>
              <span class="rseg">{g.data.segment === 'organizations' ? 'For organizations' : 'For job seekers'}</span>
              <b>{g.data.title}</b>
            </a>
          ))}
        </div>
      </div>
    </div>
  </article>

  <script>
    // Front door: touch 1 after the article's first paragraph, touch 2 before its middle section heading.
    const prose = document.querySelector('.prose');
    const t1 = document.getElementById('fd-t1'), t2 = document.getElementById('fd-t2');
    const firstP = prose?.querySelector(':scope > p');
    if (t1 && firstP) firstP.after(t1);
    const heads = prose ? Array.from(prose.querySelectorAll(':scope > h2')) : [];
    if (t2 && heads.length >= 2) heads[Math.floor(heads.length / 2)].before(t2);
  </script>

  <script>
    // WIRED 07/27 (audit row 20): the form POSTs to the app's /waitlist (stored with
    // source=guide-<slug>) and 303s back here with ?joined=1#giveaway — this script
    // just reveals the outcome. The old prototype validated locally and discarded
    // the email; that class of fake capture is over.
    const joined = new URLSearchParams(location.search).get('joined');
    if (joined) document.querySelectorAll('.giveaway').forEach((box) => {
      const form = box.querySelector('.gate');
      if (joined === '1') {
        form?.setAttribute('hidden', '');
        box.querySelector('.dl')?.removeAttribute('hidden');
        box.querySelector('.gate-note')?.removeAttribute('hidden');
      } else {
        box.querySelector('.gate-err')?.removeAttribute('hidden');
      }
    });
  </script>

  <style>
    .container.narrow { max-width: 760px; }
    .dateline { font-size: .85rem; margin-top: -8px; }
    .guide-hero { width: 100%; height: auto; border-radius: 14px; border: 1px solid var(--line); margin: 16px 0 6px; display: block; }
    .faq-block { margin-top: 26px; }
    .faq-block h2 { color: var(--ink); }
    .faq-item { border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 12px 16px; margin: 10px 0; background: var(--card); }
    .faq-item summary { cursor: pointer; font-weight: 700; color: var(--ink); }
    .faq-item p { margin: 10px 0 2px; color: var(--ink-soft); }
    .prose { font-size: 1.06rem; color: var(--ink-soft); }
    .prose :global(h2) { margin-top: 1.7em; color: var(--ink); }
    .prose :global(h3) { margin-top: 1.3em; color: var(--ink); }
    .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; }
    .prose :global(li) { margin-bottom: .45em; }
    .prose :global(strong) { color: var(--ink); }
    .prose :global(blockquote) { border-left: 3px solid var(--primary); margin: 1.2em 0; padding: .4em 0 .4em 16px; color: var(--ink); background: var(--primary-bg); border-radius: 0 8px 8px 0; }
    .giveaway { margin-top: 22px; border-color: #ddccf6; background: var(--premium-bg); }
    .giveaway h3 { margin: 8px 0 6px; }
    .gate { display: flex; flex-wrap: wrap; gap: 10px; margin: 12px 0 4px; }
    /* CSS display rules (.btn's inline-flex, .gate's flex) silently BEAT the hidden
       attribute — the Download button showed WITHOUT an email since the gate shipped,
       and after unlock the form stayed visible next to it (founder-hit 08/06, twice).
       Inside this card, [hidden] always wins. !important is load-bearing here. */
    .giveaway [hidden] { display: none !important; }
    .gate input { flex: 1 1 220px; font-family: inherit; font-size: 1rem; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius-sm); }
    .cta-card { margin-top: 38px; text-align: center; }
    .cta-card .fd-paid { margin: 14px auto 0; max-width: 56ch; }
    .cta-card .fd-paid a { text-decoration: underline; font-weight: 700; }
    .fd-touch { background: var(--accent-bg); border-left: 4px solid var(--accent-strong); border-radius: 10px; padding: 12px 16px; margin: 18px 0; }
    .fd-touch p { margin: 0; color: var(--ink); }
    .fd-touch a { font-weight: 700; text-decoration: underline; margin-left: 4px; }
    .cta-card .btn { margin-top: 6px; }
    .cta-card .cta-links { margin: 12px 0 0; font-size: .95rem; }
    .cta-card .cta-links a { text-decoration: underline; }
    .related { margin-top: 34px; }
    .related h3 { margin-bottom: 12px; }
    .rcard { display: flex; flex-direction: column; gap: 6px; color: var(--ink); padding: 18px; transition: transform .1s, box-shadow .15s; }
    .rcard:hover { text-decoration: none; transform: translateY(-2px); box-shadow: var(--shadow-lg); }
    .rseg { font-size: .74rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
  </style>
</Base>
