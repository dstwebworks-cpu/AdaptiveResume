---
import Base from '../layouts/Base.astro';
// Laid-off hub (Block A, founder 11/03/2026: "ok start with Order of work 1 and then 2"; proposal
// 05-marketing-gtm/laid-off-resources-proposal-2026-10-28.md, R7). One place for someone on a hard week:
// the key deadlines, free downloads, free public help, then the free resume check. Every fact here is
// also on the guide it links to, with its agency source (05-marketing-gtm/block-a-laid-off-sources-11-03-2026.md).
// Information only: no legal or financial advice, nothing taken from an employer's systems (severance rule).
const LAUNCHED = import.meta.env.PUBLIC_LAUNCHED === '1';
const appUrl = import.meta.env.PUBLIC_APP_URL
  ?? (import.meta.env.PROD ? 'https://app.adaptiveresume.com' : 'http://localhost:5173');
const site = Astro.site ?? new URL('https://adaptiveresume.com');
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
    { '@type': 'ListItem', position: 2, name: 'Laid off? Start here' },
  ],
};
const steps = [
  { when: 'This week', title: 'File for unemployment',
    body: 'File with the state where you worked, as soon as you can. The U.S. Department of Labor says the first payment generally arrives two to three weeks after you file.',
    href: '/guides/how-to-file-for-unemployment-by-state/', link: 'Find your state\'s official unemployment site' },
  { when: 'Within 60 days', title: 'Choose your health coverage',
    body: 'You have 60 days to elect COBRA, counted from the day your coverage ends or the day your COBRA election notice arrives, whichever is later. You can enroll in a Marketplace plan from 60 days before to 60 days after you lose job-based coverage. Compare both before either window closes.',
    href: '/guides/laid-off-what-to-do-first-30-days/#days-1-to-60-choose-your-health-coverage', link: 'Read how to choose between COBRA and a Marketplace plan' },
  { when: 'Before you sign', title: 'Read any severance agreement',
    body: 'Read the agreement early, because its deadline can come before your health coverage windows close. If you are 40 or older and it asks you to give up age discrimination claims, federal law gives you at least 21 days to consider it (at least 45 if the layoff is part of a program offered to a group of employees) and at least 7 days to change your mind after signing. Ask an employment attorney about any term you are unsure of.',
    href: '/guides/laid-off-what-to-do-first-30-days/#before-you-sign-a-severance-agreement', link: 'Read what to check before you sign' },
  { when: 'Every week', title: 'Keep your search in one place',
    body: 'Track every application, contact and follow-up date, and keep the job-search record your state may ask for.',
    href: '/guides/job-search-tracker-and-work-search-log/', link: 'Get the free job search tracker' },
];
const downloads = [
  { name: 'First 30 Days After a Layoff Checklist', what: 'It walks you through those deadlines, with a box to check for each step and a line to write each key date.', href: '/guides/laid-off-what-to-do-first-30-days/', cta: 'Get the checklist on the first 30 days guide' },
  { name: 'Weekly Claim and Work-Search Log', what: 'It gives you a printable row for each weekly claim and its confirmation number, and a separate row for each employer you contact.', href: '/guides/how-to-file-for-unemployment-by-state/', cta: 'Get the log on the unemployment filing guide' },
  { name: 'Job Search Tracker (Excel)', what: 'It tracks your applications, contacts and follow-ups, highlights follow-ups that are overdue, and fills in the counts on its own.', href: '/guides/job-search-tracker-and-work-search-log/', cta: 'Get the Excel tracker on its guide page' },
  { name: 'Restart Plan Worksheet', what: 'Made for a search of six months or more, it covers benefits, health coverage, questions for your American Job Center, and a first draft of your gap line.', href: '/guides/long-term-unemployed-restarting-your-job-search/', cta: 'Get the worksheet on the long-term search guide' },
];
---
<Base
  title="Laid Off? Start Here: Free Help, Deadlines and Tools"
  description="Find free help after a layoff. Learn how to file for unemployment, meet the 60-day health coverage deadlines, read severance terms and find job help."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

  <section class="hero">
    <div class="container">
      <p class="eyebrow">Free help after a layoff</p>
      <h1>Laid off? <span class="hl">Start here.</span></h1>
      <p class="lede">
        Losing a job brings a few deadlines that cost money if you miss them, and a lot that can wait.
        This page puts the urgent things first and gathers our free guides and downloads in one place.
        Our guides link the rules they describe to an official source, such as the agency in charge or the law itself, so you can check them yourself.
      </p>
      <div class="cta-row">
        <a class="btn btn-amber btn-lg" href="/guides/laid-off-what-to-do-first-30-days/">Read what to do in the first 30 days</a>
        <a class="btn btn-ghost btn-lg" href="/guides/how-to-file-for-unemployment-by-state/">Find your state's official unemployment site</a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">Key deadlines</p>
      <h2>What to do first, and when</h2>
      <div class="grid cols-2">
        {steps.map((s) => (
          <div class="card">
            <p class="eyebrow">{s.when}</p>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <p><a href={s.href}>{s.link}</a></p>
          </div>
        ))}
      </div>
      <p class="muted" style="margin-top:14px">This is general information, not legal or financial advice. Rules change and states differ, so for your own situation, ask the agency named in each guide or an employment attorney.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Free downloads</p>
      <h2>Four free tools for after a layoff</h2>
      <p class="muted">To get one, open the guide it goes with and enter your email in the download box near the end of that page.</p>
      <div class="grid cols-2">
        {downloads.map((d) => (
          <div class="card">
            <h3>{d.name}</h3>
            <p>{d.what}</p>
            <p><a href={d.href}>{d.cta}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">If the search has run long</p>
      <h2>Out of work six months or more</h2>
      <p>
        In the Bureau of Labor Statistics' September 2026 report, more than one in four unemployed people had
        been looking for work for 27 weeks or more. After six months, your regular unemployment benefits may be ending or may already have ended, because most
        states pay them for no more than 26 weeks. Now is a good time to ask about public help, including the Dislocated
        Worker program under the federal Workforce Innovation and Opportunity Act (WIOA), which can pay for training. Running out of unemployment benefits does not, by itself, shut you out of that program.
      </p>
      <p><a href="/guides/long-term-unemployed-restarting-your-job-search/">Read the guide for people out of work six months or more</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Free help near you</p>
      <h2>American Job Centers</h2>
      <p>
        There are about 2,300 American Job Centers across the country. The Department of Labor says they offer
        job search help and re-employment services for people on unemployment, and services vary by state. To find
        your nearest center, use the <a href="https://www.careeronestop.org/LocalHelp/AmericanJobCenters/find-american-job-centers.aspx">American Job Center Finder</a>
        or call 1-877-US-2JOBS.
      </p>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">When you're ready to apply</p>
      <h2>Getting your resume ready</h2>
      <p>
        You don't need to rewrite your resume in the first week. When you start applying, our guide on
        <a href="/guides/how-to-explain-employment-gap-on-resume/">how to explain an employment gap</a> shows calm,
        honest ways to handle time away, and our guide on
        <a href="/guides/how-to-list-self-employment-on-resume/">how to list self-employment</a> covers freelance and
        contract work you take on in the meantime.
      </p>
      {LAUNCHED && <p class="step-line">Start with a free check: we'll show you how screening software reads your resume. If you want us to find what your resume leaves out, the full resume build is $29, with no subscription and no auto-renewal.</p>}
      <div class="cta-row">
        {LAUNCHED
          ? <a class="btn btn-amber btn-lg" href={`${appUrl}/?start=check`}>Check my resume free</a>
          : <a class="btn btn-amber btn-lg" href="/demo/">See it work on a sample resume, no sign-up needed</a>}
      </div>
    </div>
  </section>
</Base>
