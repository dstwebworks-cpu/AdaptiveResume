---
// A short footer on every page (founder 11/20/2026, "Short footer site-wide"): the homepage's type and colors (weights 400
// and 700, ink and one gray), every legal link, the main pages and the service pages, and a way to reach us.
const year = new Date().getFullYear();
const pages = [
  { href: '/#job-seekers', label: 'For job seekers' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/guides/', label: 'Guides and templates' },
  { href: '/demo/', label: 'Try the demo' },
  { href: '/fix/', label: 'Fix a resume you paid for' },
  { href: '/career-change/', label: 'Career change' },
  { href: '/nurses/', label: 'For nurses' },
  { href: '/veterans/', label: 'For veterans' },
  { href: '/business/', label: 'For organizations' },
  { href: '/resume-writing-service/', label: 'Resume writing service' },
  { href: '/rewrite-my-resume/', label: 'Rewrite my resume' },
  { href: '/update-my-resume/', label: 'Update my resume' },
  { href: '/resume-makeover/', label: 'Resume makeover' },
  { href: '/resume-editing-service/', label: 'Resume editing service' },
];
const legal = [
  { href: '/terms/', label: 'Terms of Service' },
  { href: '/privacy/', label: 'Privacy Policy' },
  { href: '/privacy/#your-privacy-choices', label: 'Your Privacy Choices' },
  { href: '/acceptable-use/', label: 'Acceptable Use' },
  { href: '/disclaimer/', label: 'Disclaimer' },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <a class="brand" href="/" aria-label="AdaptiveResume home"><span class="mark" aria-hidden="true">AR</span><span>Adaptive<span style="color:var(--accent)">Resume</span></span></a>
      <p>Questions? Email <a href="mailto:support@adaptiveresume.com">support@adaptiveresume.com</a>.</p>
    </div>
    <nav class="links" aria-label="Site">{pages.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
    <nav class="links" aria-label="Legal">{legal.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
    <div class="bottom">
      {/* Swap "AdaptiveResume" for the formed legal entity name once the LLC-vs-DBA decision lands (see 00-overview TODO, Stage 1). */}
      <p>© {year} AdaptiveResume.</p>
      <a class="social" href="https://www.linkedin.com/company/adaptiveresume" rel="me noopener" target="_blank" aria-label="Follow us on LinkedIn (opens in a new tab)">
        <span class="li-badge" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="#fff"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></span>
        <span>Follow us on LinkedIn</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface); border-top: 1px solid var(--line); padding: 28px 0 32px; color: var(--muted); font-size: var(--fs-small); }
  .site-footer p { margin: 0; }
  .site-footer a { color: var(--muted); }
  .site-footer a:hover { color: var(--ink); }
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 24px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: var(--fs-brand); color: var(--ink) !important; }
  .brand:hover { text-decoration: none; }
  .mark { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: #F39F0C; color: #18222D; font-size: var(--fs-mark); font-weight: 700; }
  .top a[href^="mailto:"] { color: var(--ink); font-weight: 700; overflow-wrap: anywhere; }
  .top > *, .bottom > * { min-width: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 18px; }
  .links + .links { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); }
  .bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 20px; margin-top: 18px; }
  /* LinkedIn in the bottom bar (founder 10/18/2026: "should be in the site footer... pop a little with Blue square icon"); #0A66C2 is LinkedIn's own brand blue for its mark */
  .social { display: inline-flex; align-items: center; gap: 8px; color: var(--ink) !important; font-weight: 700; }
  .li-badge { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 7px; background: #0A66C2; }
  .social:hover .li-badge { background: #004182; }
</style>
