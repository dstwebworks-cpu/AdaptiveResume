---
// Nav links resolve to real pages / on-page anchors (M1).
// Pre-launch (default): app CTAs become email capture — set PUBLIC_LAUNCHED=1 at
// build to flip the site live. appUrl = the product app (separate deploy); prod
// builds default to the real app origin so a forgotten env var can never ship
// localhost links again (the 07/27 audit finding).
const LAUNCHED = import.meta.env.PUBLIC_LAUNCHED === '1';
const appUrl = import.meta.env.PUBLIC_APP_URL
  ?? (import.meta.env.PROD ? 'https://app.adaptiveresume.com' : 'http://localhost:5173');
const links = [
  { href: '/#job-seekers', label: 'For job seekers' },
  { href: '/business/', label: 'For organizations' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/guides/', label: 'Guides' },
  { href: '/#how-it-works', label: 'How it works' },
];
---
<header class="site-header" id="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="AdaptiveResume home">
      <span class="mark" aria-hidden="true">AR</span>
      <span class="word">Adaptive<span style="color:var(--accent)">Resume</span></span>
    </a>

    <nav class="nav desktop" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    {LAUNCHED && <a class="signin cta-desktop" href={appUrl + '/login'}>Sign in</a>}
    <a class="btn btn-primary cta-desktop hdr-buy" href={LAUNCHED ? `${appUrl}/buy` : '/#get-started'}>{LAUNCHED ? 'Buy now' : 'Join the launch list for 25% off'}</a>

    {LAUNCHED && <a class="signin signin-phone" href={appUrl + '/login'}>Sign in</a>}
    {LAUNCHED && <a class="btn btn-primary cta-phone hdr-buy" href={`${appUrl}/buy`}>Buy now</a>}

    <button class="hamburger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    {LAUNCHED && <a href={appUrl + '/login'}>Sign in</a>}
    <a class="btn btn-primary" href={LAUNCHED ? `${appUrl}/buy` : '/#get-started'}>{LAUNCHED ? 'Buy now' : 'Join the launch list for 25% off'}</a>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  // Option C (11/20/2026): on a page with its own main Buy now button (data-hero-buy), the header shows Sign in until that
  // button has scrolled away, and again while any part marked data-hide-header-buy (the prices) is on screen.
  const heroBuy = document.querySelector('[data-hero-buy]');
  if (header && heroBuy && 'IntersectionObserver' in window) {
    header.classList.add('await-buy');
    let past = false;
    const showing = new Set<Element>();
    const update = () => header.classList.toggle('await-buy', !past || showing.size > 0);
    new IntersectionObserver(([e]) => { past = !e.isIntersecting && e.boundingClientRect.top < 0; update(); }).observe(heroBuy);
    const watch = new IntersectionObserver((list) => {
      for (const e of list) { if (e.isIntersecting) showing.add(e.target); else showing.delete(e.target); }
      update();
    }, { rootMargin: '-64px 0px 0px 0px' });
    document.querySelectorAll('[data-hide-header-buy]').forEach((el) => watch.observe(el));
  }
  if (header) {
    const btn = header.querySelector('.hamburger');
    const close = () => { header.classList.remove('menu-open'); btn?.setAttribute('aria-expanded', 'false'); btn?.setAttribute('aria-label', 'Open menu'); };
    btn?.addEventListener('click', () => {
      const open = header.classList.toggle('menu-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    header.querySelectorAll('.mobile-menu a').forEach((a) => a.addEventListener('click', close));
    // Re-check H1 (11/18/2026): when the screen turns or widens into the desktop row, the menu button goes away, so an open
    // menu closes with it (it used to stay open with every link shown twice). The button is watched too, because setting text
    // smaller on a wide screen brings the desktop row back without changing the bar's size (re-check 3 H1b).
    const bar = header.querySelector('.bar');
    if (bar && btn && 'ResizeObserver' in window) {
      const ro = new ResizeObserver(() => { if (header.classList.contains('menu-open') && getComputedStyle(btn).display === 'none') close(); });
      ro.observe(bar);
      ro.observe(btn);
    }
  }
</script>

<style>
  .site-header { container-type: inline-size; container-name: hdr; position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.93); backdrop-filter: saturate(150%) blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding-block: 8px; min-height: 64px; container-type: inline-size; container-name: bar; }
  .brand { display: flex; align-items: center; gap: 10px; margin-right: auto; font-weight: 800; font-size: var(--fs-brand); color: var(--ink); letter-spacing: -0.02em; }
  .brand:hover { text-decoration: none; }
  .mark { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; background: #F39F0C; color: #18222D; font-size: var(--fs-mark); font-weight: 800; }

  .nav.desktop { display: none; gap: 22px; margin-left: auto; }
  .nav.desktop a { color: var(--ink-soft); font-weight: 700; font-size: var(--fs-small); white-space: nowrap; }
  .nav.desktop a:hover { color: var(--ink); text-decoration: none; }
  /* 7px top and bottom (was 9px): buttons are now the 17px body size, and the desktop header keeps its live height. */
  .cta-desktop { display: none; padding: 7px 16px; white-space: nowrap; }
  a.signin { font-weight: 700; color: var(--ink); font-size: var(--fs-small); padding: 9px 6px; white-space: nowrap; }
  a.signin:hover { color: var(--accent); text-decoration: none; }

  /* hamburger (mobile) */
  .hamburger { display: inline-flex; flex-direction: column; justify-content: center; gap: 5px; width: 40px; height: 44px; padding: 10px 9px; background: none; border: 1px solid var(--line); border-radius: 9px; cursor: pointer; }
  .hamburger span { display: block; height: 2px; width: 100%; background: var(--ink); border-radius: 2px; transition: transform .2s, opacity .2s; }
  .menu-open .hamburger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-open .hamburger span:nth-child(2) { opacity: 0; }
  .menu-open .hamburger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu { display: none; flex-direction: column; gap: 4px; padding: 10px 22px 18px; border-top: 1px solid var(--line); background: #fff; }
  /* Re-check R6: on a wide screen at large text the menu panel lines up with the bar instead of stretching across the window. */
  .menu-open .mobile-menu { max-width: 1120px; margin-inline: auto; }
  .menu-open .mobile-menu { display: flex; }
  .mobile-menu a:not(.btn) { padding: 13px 8px; color: var(--ink); font-weight: 700; border-bottom: 1px solid var(--surface); }
  .mobile-menu a:not(.btn):hover { text-decoration: none; }
  .mobile-menu .btn { margin-top: 10px; }

  /* Phone header button: shown only where it fits on the logo's row, decided by the header's own width in root text units (rem, the same unit the
     button uses), so larger text settings switch it off sooner instead of letting it slide over the menu (found at 200% text, 320 px, 10/31/2026).
     The brand name always shows (founder 11/14/2026: "We need our brand to be known"). Option C (founder 11/20/2026): the button never takes a
     second, full-width row (that made the phone header 113 px tall); where it does not fit, Buy now is in the menu. */
  .cta-phone { display: none; padding: 8px 10px; font-size: var(--fs-small); white-space: nowrap; min-height: 40px; }
  .signin-phone { display: none; }
  /* Measured 11/20/2026: the name, the button, the menu and two gaps take 310 px; Sign in in the button's place takes 297 px. */
  @container bar (min-width: 19.375rem) { .cta-phone { display: inline-flex; justify-content: center; } }
  @container bar (min-width: 18.75rem) { .site-header.await-buy .signin-phone { display: inline-flex; } }
  .site-header.await-buy .hdr-buy { display: none !important; }

  /* Desktop row from 900 px at normal text, as live. Site review 11/18/2026 (N1): it is decided by the header's own width in rem,
     so with large text the header keeps the menu layout until the whole desktop row fits (it ran 13 to 97 px off screen at 940 to
     1080 px with 200% text). This replaces the 11/14/2026 short-logo rule for 900 to 920 px at 200% text: those widths now get the
     menu layout, where the name, the button and the menu all fit. */
  /* Re-check R4 (11/18/2026): the switch is decided by the bar's own width, not the window's. The bar is capped at 1120 px, so on a
     wide screen at large text the header's width said "fits" while the row did not, and every label wrapped ("Buy / now").
     The bar's spacing still follows the header, which never differs from the bar at normal text. */
  @container hdr (min-width: 56.25rem) {
    /* Desktop keeps the live one-row header exactly (re-check of 11/14/2026, FIX E): the wrap, padding and gaps above are for phones. */
    .bar { flex-wrap: nowrap; gap: 14px; padding-block: 0; }
  }
  @container bar (min-width: 56.25rem) {
    .cta-phone, .signin-phone { display: none !important; }
    .brand { margin-right: 0; }
    .nav.desktop { display: flex; }
    .cta-desktop { display: inline-flex; }
    .hamburger { display: none; }
  }
</style>
