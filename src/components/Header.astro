---
// Nav links resolve to real pages / on-page anchors (M1).
// Pre-launch (default): app CTAs become email capture — set PUBLIC_LAUNCHED=1 at
// build to flip the site live. appUrl = the product app (separate deploy); prod
// builds default to the real app origin so a forgotten env var can never ship
// localhost links again (the 07/27 audit finding).
const LAUNCHED = import.meta.env.PUBLIC_LAUNCHED === '1';
const appUrl = import.meta.env.PUBLIC_APP_URL
  ?? (import.meta.env.PROD ? 'https://app.adaptiveresume.com' : 'http://localhost:5173');
const links = [
  { href: '/#job-seekers', label: 'For job seekers' },
  { href: '/business/', label: 'For organizations' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/guides/', label: 'Guides' },
  { href: '/#how-it-works', label: 'How it works' },
];
---
<header class="site-header" id="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="AdaptiveResume home">
      <span class="mark" aria-hidden="true">AR</span>
      <span class="word">Adaptive<span style="color:var(--accent)">Resume</span></span>
    </a>

    <nav class="nav desktop" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    {LAUNCHED && <a class="signin cta-desktop" href={appUrl + '/login'}>Sign in</a>}
    <a class="btn btn-primary cta-desktop" href={LAUNCHED ? `${appUrl}/?start=check` : '/#get-started'}>{LAUNCHED ? 'Check my resume free' : 'Join the launch list for 25% off'}</a>

    {LAUNCHED && <a class="btn btn-primary cta-phone" href={`${appUrl}/?start=check`}>Check my resume free</a>}

    <button class="hamburger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    {LAUNCHED && <a href={appUrl + '/login'}>Sign in</a>}
    <a class="btn btn-primary" href={LAUNCHED ? `${appUrl}/?start=check` : '/#get-started'}>{LAUNCHED ? 'Check my resume free' : 'Join the launch list for 25% off'}</a>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const btn = header.querySelector('.hamburger');
    const close = () => { header.classList.remove('menu-open'); btn?.setAttribute('aria-expanded', 'false'); btn?.setAttribute('aria-label', 'Open menu'); };
    btn?.addEventListener('click', () => {
      const open = header.classList.toggle('menu-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    header.querySelectorAll('.mobile-menu a').forEach((a) => a.addEventListener('click', close));
  }
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.93); backdrop-filter: saturate(150%) blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 14px; min-height: 64px; container-type: inline-size; container-name: bar; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; color: var(--ink); letter-spacing: -0.02em; }
  .brand:hover { text-decoration: none; }
  .mark { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; background: #F39F0C; color: #18222D; font-size: .78rem; font-weight: 800; }

  .nav.desktop { display: none; gap: 22px; margin-left: auto; }
  .nav.desktop a { color: var(--ink-soft); font-weight: 600; font-size: .96rem; }
  .nav.desktop a:hover { color: var(--ink); text-decoration: none; }
  .cta-desktop { display: none; padding: 9px 16px; }
  a.signin { font-weight: 700; color: var(--ink); font-size: .96rem; padding: 9px 6px; }
  a.signin:hover { color: var(--accent); text-decoration: none; }

  /* hamburger (mobile) */
  .hamburger { margin-left: auto; display: inline-flex; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; padding: 10px; background: none; border: 1px solid var(--line); border-radius: 9px; cursor: pointer; }
  .hamburger span { display: block; height: 2px; width: 100%; background: var(--ink); border-radius: 2px; transition: transform .2s, opacity .2s; }
  .menu-open .hamburger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-open .hamburger span:nth-child(2) { opacity: 0; }
  .menu-open .hamburger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu { display: none; flex-direction: column; gap: 4px; padding: 10px 22px 18px; border-top: 1px solid var(--line); background: #fff; }
  .menu-open .mobile-menu { display: flex; }
  .mobile-menu a:not(.btn) { padding: 13px 8px; color: var(--ink); font-weight: 600; border-bottom: 1px solid var(--surface); }
  .mobile-menu a:not(.btn):hover { text-decoration: none; }
  .mobile-menu .btn { margin-top: 10px; }

  /* Phone header button: shown only where it fits, decided by the header's own width in root text units (rem, the same unit the button uses), so larger text
     settings switch it off sooner instead of letting it slide over the menu (found at 200% text, 320 px, 10/31/2026). */
  .cta-phone { display: none; margin-left: auto; padding: 8px 11px; font-size: .86rem; white-space: nowrap; min-height: 44px; }
  @container bar (min-width: 15.75rem) { .cta-phone { display: inline-flex; } .cta-phone + .hamburger { margin-left: 0; } .word { display: none; } }
  @container bar (min-width: 27.5rem) { .word { display: inline; } }

  @media (min-width: 900px) {
    .cta-phone { display: none !important; }
    .nav.desktop { display: flex; }
    .cta-desktop { display: inline-flex; }
    .hamburger { display: none; }
    .mobile-menu { display: none !important; }
  }
</style>
