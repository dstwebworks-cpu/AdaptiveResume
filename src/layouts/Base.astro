---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'AdaptiveResume — the skills you already earned, on paper',
  description = 'A guided resume tool that finds the skills, standards, and credentials you genuinely have but left off — and asks you to confirm each one. Nothing made up. No guaranteed outcomes.',
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = Astro.site ? new URL('/img/social-card-1200x628.png', Astro.site).href : '/img/social-card-1200x628.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      // Returning from a form POST (?joined= / ?quoted=): jump straight to the
      // confirmation instead of smooth-animating the whole page down to it.
      if (/[?&](joined|quoted)=/.test(location.search)) document.documentElement.style.scrollBehavior = 'auto';
    </script>
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Instant feedback on any capture form: the POST->303 round trip takes a
      // moment, and a silent button reads as broken.
      addEventListener('submit', (e) => {
        const f = e.target;
        if (f instanceof HTMLFormElement && f.method.toLowerCase() === 'post') {
          const b = f.querySelector('button[type="submit"]');
          if (b) { b.disabled = true; b.textContent = 'One moment…'; }
        }
      });
    </script>
  </body>
</html>
