---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'AdaptiveResume — the skills you already earned, on paper',
  description = 'A guided resume tool that finds the skills, standards, and credentials you genuinely have but left off — and asks you to confirm each one. Nothing made up. No guaranteed outcomes.',
} = Astro.props;

// GA4 measurement ID — empty string disables the tag entirely (nothing renders).
// Measurement-only per privacy policy: allow_google_signals stays false; do not
// enable ads personalization without updating /privacy first.
const GA_ID = 'G-H7K2RZW0N7';

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = Astro.site ? new URL('/img/social-card-1200x628.png', Astro.site).href : '/img/social-card-1200x628.png';
// Site-wide structured data (SEO audit chunk, 07/29). Claims kept minimal and true —
// no aggregate ratings, no fabricated sameAs profiles (add social URLs when handles exist).
const siteUrl = Astro.site?.href ?? 'https://adaptiveresume.com/';
const siteLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'AdaptiveResume', url: siteUrl,
    logo: new URL('/img/social-card-1200x1200.png', siteUrl).href,
    email: 'support@adaptiveresume.com' },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'AdaptiveResume', url: siteUrl },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      // Returning from a form POST (?joined= / ?quoted=): jump straight to the
      // confirmation instead of smooth-animating the whole page down to it.
      if (/[?&](joined|quoted)=/.test(location.search)) document.documentElement.style.scrollBehavior = 'auto';
    </script>
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteLd)} />
    {GA_ID && import.meta.env.PROD && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          // Opt-out before anything loads: the privacy-page toggle (localStorage)
          // or the browser's Global Privacy Control signal — either keeps GA off.
          window.__arGaDisableKey = 'ga-disable-' + GA_ID;
          if (localStorage.getItem('ar-analytics-optout') === '1' || navigator.globalPrivacyControl) {
            window[window.__arGaDisableKey] = true;
          }
          gtag('js', new Date());
          gtag('config', GA_ID, { allow_google_signals: false });
          // The capture forms 303 back with ?joined= / ?quoted= — that's the
          // conversion moment. localStorage (not session) so reloads, back-navs,
          // AND later sessions revisiting the URL from history can never re-fire
          // (08/03: Ads reported 48 conversions vs 5 real signups). The param must
          // stay in the URL — the confirmation UI and guide-template unlock
          // re-read it on refresh.
          var m = location.search.match(/[?&](joined|quoted)=/);
          if (m && !localStorage.getItem('ga-conv-' + m[1])) {
            localStorage.setItem('ga-conv-' + m[1], '1');
            gtag('event', m[1] === 'joined' ? 'sign_up' : 'generate_lead');
          }
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Instant feedback on any capture form: the POST->303 round trip takes a
      // moment, and a silent button reads as broken.
      addEventListener('submit', (e) => {
        const f = e.target;
        if (f instanceof HTMLFormElement && f.method.toLowerCase() === 'post') {
          const b = f.querySelector('button[type="submit"]');
          if (b) { b.disabled = true; b.textContent = 'One moment…'; }
        }
      });
    </script>
  </body>
</html>
